---
// Where a member's money came from, one stacked bar per election cycle on a
// shared scale. Three series: individuals, PACs, everything else.
import { money, percent, type Member } from "../lib/data";

interface Props {
  totals: Member["totals"];
}
const { totals } = Astro.props;

const SERIES = [
  { key: "individual", label: "Individuals", color: "--series-1" },
  { key: "pac", label: "PACs", color: "--series-2" },
  { key: "other", label: "Party, self & other", color: "--series-3" },
] as const;

const rows = Object.entries(totals)
  .map(([cycle, t]) => {
    const other = Math.max(t.receipts - t.individual - t.pac, 0);
    return { cycle, receipts: t.receipts, values: { individual: t.individual, pac: t.pac, other } };
  })
  .reverse();
const max = Math.max(...rows.map((r) => r.receipts), 1);
---

{
  rows.length > 0 && (
    <figure class="cycles" aria-label="Money raised by election cycle and source">
      <ul class="legend">
        {SERIES.map((s) => (
          <li>
            <span class="swatch" style={`background: var(${s.color})`} />
            {s.label}
          </li>
        ))}
      </ul>
      {rows.map((r) => (
        <div class="row">
          <span class="cycle">{Number(r.cycle) - 1}–{r.cycle.slice(2)}</span>
          <div class="track">
            <div class="bar" style={`width: calc((100% - 64px) * ${r.receipts / max})`}>
              {SERIES.map((s) =>
                r.values[s.key] > 0 ? (
                  <div
                    class="segment"
                    tabindex="0"
                    style={`flex-grow: ${r.values[s.key]}; background: var(${s.color})`}
                    data-tip={`${r.cycle} · ${s.label}: ${money(r.values[s.key])} (${percent(r.values[s.key], r.receipts)})`}
                  />
                ) : null
              )}
            </div>
            <span class="value">{money(r.receipts, true)}</span>
          </div>
        </div>
      ))}
      <table class="visually-hidden">
        <caption>Money raised by cycle</caption>
        <thead>
          <tr><th>Cycle</th>{SERIES.map((s) => <th>{s.label}</th>)}<th>Total</th></tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr><td>{r.cycle}</td>{SERIES.map((s) => <td>{money(r.values[s.key])}</td>)}<td>{money(r.receipts)}</td></tr>
          ))}
        </tbody>
      </table>
    </figure>
  )
}

<style>
  .cycles { margin: 0; }
  .legend { display: flex; gap: 18px; flex-wrap: wrap; list-style: none; padding: 0; margin: 0 0 12px; font-size: 13px; color: var(--text-secondary); }
  .swatch { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }
  .row { display: grid; grid-template-columns: 64px 1fr; gap: 12px; align-items: center; padding: 5px 0; }
  .cycle { font-size: 13px; color: var(--text-secondary); font-variant-numeric: tabular-nums; }
  .track { display: flex; align-items: center; gap: 8px; }
  .bar { display: flex; gap: 2px; height: 16px; flex: none; min-width: 3px; }
  .segment { flex-basis: 0; min-width: 2px; }
  .segment:last-child { border-radius: 0 4px 4px 0; }
  .segment:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
  .value { font-size: 13px; color: var(--text-secondary); font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>
