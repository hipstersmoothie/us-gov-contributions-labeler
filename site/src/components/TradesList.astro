---
// A server-rendered table of reported trades. The full list is never shipped
// to the browser as one file: these reports can't be offered for bulk reuse
// (5 U.S.C. § 13107), so pages carry at most a page of rows.
import { reportUrl, type TradeRow } from "../lib/holdings";

interface Props {
  rows: TradeRow[];
  caption: string;
}
const { rows, caption } = Astro.props;
const date = (iso: string) => new Date(`${iso}T12:00:00`).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<table class="trades-list">
  <caption class="visually-hidden">{caption}</caption>
  <thead>
    <tr>
      <th scope="col">Member</th>
      <th scope="col">Asset</th>
      <th scope="col" class="wide">Whose</th>
      <th scope="col" class="num">Traded</th>
      <th scope="col" class="num">Amount</th>
      <th scope="col" class="num wide">Reported after</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((r) => (
        <tr>
          <th scope="row">
            <span class={`ptag party-${r.party}`}>{r.party}</span>
            <a href={`/members/${r.bioguide}/investments/`}>{r.member}</a>
          </th>
          <td>
            <span class="tx">{r.tx}</span> {r.asset}
            {r.scanned && <a class="scan-tag" href={r.docUrl} title="Read by machine from a scanned paper form">Scan</a>}
            {r.scanned && (
              <a class="report" href={reportUrl(r.member, `${r.tx} ${r.asset}, ${r.date}, ${r.amount}, ${r.owner}`, r.docUrl)}>Report a problem</a>
            )}
          </td>
          <td class="wide">{r.owner}</td>
          <td class="num">{date(r.date)}</td>
          <td class="num">{r.amount}</td>
          <td class="num wide"><a href={r.docUrl}>{r.lagDays < 0 ? "Date error in filing" : `${r.lagDays} days`}</a></td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .trades-list th[scope="row"] { font-weight: 500; text-transform: none; letter-spacing: 0; font-size: var(--fs-base); color: var(--text-primary); border-bottom: 1px solid var(--hairline); }
  .tx { display: block; font-size: var(--fs-sm); color: var(--text-muted); }
  .report { display: block; font-size: var(--fs-label); color: var(--text-muted); }
  .scan-tag {
    display: inline-block; margin-left: 6px; padding: 0 5px; border: 1px solid var(--hairline); border-radius: 2px; text-decoration: none;
    font-size: var(--fs-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-secondary);
  }
  @media (max-width: 640px) {
    .wide { display: none; }
  }
</style>
