---
// Independent expenditures, for and against, as a plain table. Support and
// opposition are different acts, so they get separate columns, never a sum.
import { money } from "../lib/data";

const PARTY: Record<string, string> = { D: "Democrat", R: "Republican", I: "Independent" };

interface Row {
  label: string;
  href?: string;
  note?: string;
  /** Party letter, shown as a lettered tag like the other member tables. */
  party?: string;
  support: number;
  oppose: number;
}
interface Props {
  rows: Row[];
  heading: string;
  supportHeading?: string;
  opposeHeading?: string;
}
const { rows, heading, supportHeading = "Supporting", opposeHeading = "Opposing" } = Astro.props;
---

<div class="outside-wrap">
<table class="outside">
  <thead>
    <tr><th>{heading}</th><th class="num">{supportHeading}</th><th class="num">{opposeHeading}</th></tr>
  </thead>
  <tbody>
    {
      rows.map((r) => (
        <tr>
          <td>
            {r.party && <span class={`ptag party-${r.party}`} title={PARTY[r.party]}><span aria-hidden="true">{r.party}</span><span class="visually-hidden">{PARTY[r.party]}</span></span>}
            {r.href ? <a href={r.href}>{r.label}</a> : r.label}
            {r.note && <div class:list={["muted", "small", { indent: r.party }]}>{r.note}</div>}
          </td>
          <td class="num">{r.support ? money(r.support, true) : <span class="muted">–</span>}</td>
          <td class="num">{r.oppose ? money(r.oppose, true) : <span class="muted">–</span>}</td>
        </tr>
      ))
    }
  </tbody>
</table>
</div>

<style>
  .indent { padding-left: calc(1.55em + 6px); }
  .outside-wrap { overflow-x: auto; }
  /* Long column headings ("Supporting their opponents") wrap instead of widening the table. */
  .outside th.num { white-space: normal; width: 8.5em; vertical-align: bottom; }
  @media (max-width: 640px) { .outside th.num { width: 6.5em; } }
</style>
