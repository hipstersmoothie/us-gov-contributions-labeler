---
// One Observable Plot chart. Rendered here at build time (a static SVG that
// works without JS), then re-rendered in the browser at the container's real
// width with Plot's interactive tip. Every chart ships a legend for 2+ series
// and a table view, so nothing rests on color or hover alone.
import * as Plot from "@observablehq/plot";
import { parseHTML } from "linkedom";
import { charts, stripMarkLabels, type ChartName } from "../lib/charts";
import MoreDisclosure from "../islands/MoreDisclosure";

interface LegendItem {
  label: string;
  color: string;
  shape?: "dot" | "square" | "ring" | "tick";
}
interface Props {
  chart: ChartName;
  data: unknown;
  /** Width of the static render; the client redraws at the real width. */
  width?: number;
  label: string;
  legend?: LegendItem[];
  /** Cells are text, or { text, href } for a link (the keyboard route to what a chart's marks open). */
  table?: { columns: string[]; rows: (string | number | { text: string; href: string })[][]; numeric?: number[] };
}
const { chart, data, width = 1040, label, legend, table } = Astro.props;

const { document } = parseHTML("<!doctype html><html><body></body></html>");
const el = Plot.plot({ ...charts[chart](data as never, { width, interactive: false }), document } as Plot.PlotOptions) as unknown as Element;
stripMarkLabels(el);
const svg = el.outerHTML;
const json = JSON.stringify({ chart, data }).replace(/</g, "\\u003c");
---

<figure class="plot-figure" aria-label={label}>
  {
    legend && legend.length > 0 && (
      <ul class="legend" aria-label="Legend">
        {legend.map((l) => (
          <li>
            <span class:list={["key", l.shape ?? "square"]} style={`--key: ${l.color}`} aria-hidden="true" />
            {l.label}
          </li>
        ))}
      </ul>
    )
  }
  <plot-chart data-width={width}>
    <div class="canvas" set:html={svg} />
    <script type="application/json" set:html={json} />
  </plot-chart>
  <slot name="note" />
  {
    table && (
      <MoreDisclosure client:visible title="Table view">
        <div class="table-scroll">
          <table>
            <caption class="visually-hidden">{label}</caption>
            <thead>
              <tr>{table.columns.map((c, i) => <th class:list={{ num: table.numeric?.includes(i) }} scope="col">{c}</th>)}</tr>
            </thead>
            <tbody>
              {table.rows.map((r) => (
                <tr>
                  {r.map((v, i) => (
                    <td class:list={{ num: table.numeric?.includes(i) }}>{typeof v === "object" ? <a href={v.href}>{v.text}</a> : v}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </MoreDisclosure>
    )
  }
</figure>

<script>
  // Plot (and the chart specs) load on demand; until then the build-time SVG
  // is what readers see.
  type Spec = { chart: string; data: unknown };
  let lib: Promise<[typeof import("@observablehq/plot"), typeof import("../lib/charts")]> | undefined;
  const load = () => (lib ??= Promise.all([import("@observablehq/plot"), import("../lib/charts")]));

  type Value = { href?: string } | null | undefined;
  const nextFrame = () => new Promise((r) => requestAnimationFrame(r));

  class PlotChart extends HTMLElement {
    #width = 0;
    #spec?: Spec;
    #visible = false;
    /** The interactive render, once Plot has loaded. */
    #plot?: SVGSVGElement;
    #drawn?: () => void;
    #ready = new Promise<void>((resolve) => (this.#drawn = resolve));
    /** The pointer that last went down on the chart: "mouse", "touch" or "pen". */
    #pointer = "mouse";
    #tapped = false;

    connectedCallback() {
      const json = this.querySelector('script[type="application/json"]');
      if (!json?.textContent) return;
      this.#spec = JSON.parse(json.textContent);
      // The build-time SVG is right at its own width; Plot only has to load
      // for the hover tip, or to redraw at a different width (phones, tablets).
      this.addEventListener("pointerenter", () => this.#start(), { once: true });
      this.addEventListener("focusin", () => this.#start(), { once: true });
      new IntersectionObserver(
        ([entry], io) => {
          if (!entry?.isIntersecting) return;
          io.disconnect();
          if (Math.abs(this.clientWidth - Number(this.dataset.width)) > 24) this.#start();
        },
        { rootMargin: "300px" }
      ).observe(this);
      new ResizeObserver(() => {
        if (Math.abs(this.clientWidth - Number(this.dataset.width)) > 24) this.#start();
        this.#render();
      }).observe(this);

      // Plot's pointer shows a tip as soon as a finger touches the chart, even
      // to scroll, and only hides it when a mouse leaves, so on a phone tips
      // pop up mid-scroll and stay. Plot hears from the mouse only; a tap
      // (a click, so never a scroll) shows the tip at the finger, and the next
      // tap outside the chart, or a scroll that starts on it, closes it.
      for (const type of ["pointerenter", "pointermove", "pointerdown", "pointerleave"]) {
        this.addEventListener(
          type,
          (e) => {
            const { pointerType } = e as PointerEvent;
            if (type === "pointerdown") this.#pointer = pointerType;
            if (pointerType !== "mouse" && e.isTrusted) e.stopPropagation();
          },
          { capture: true }
        );
      }
      this.addEventListener("pointercancel", () => this.#dismiss());
      this.addEventListener("click", (e) => this.#click(e));
    }

    #start() {
      if (this.#visible) return;
      this.#visible = true;
      this.#render();
    }

    get #value() {
      return (this.#plot as unknown as { value?: Value } | undefined)?.value;
    }

    // Marks whose data carry an href (swarm dots) open it: on a click with a
    // mouse, or on a second tap on the same mark. Plot's pointer picks the
    // nearest mark, so there's no need to hit a 6px dot.
    async #click(e: MouseEvent) {
      if ((e.target as Element).closest("a")) return;
      if (this.#pointer === "mouse") {
        // A keyboard "click" (detail 0) only comes from a link, handled above.
        const href = this.#value?.href;
        if (!href || e.detail === 0) return;
        if (e.metaKey || e.ctrlKey) window.open(href, "_blank");
        else location.href = href;
        return;
      }
      this.#start();
      await this.#ready;
      const before = this.#value;
      this.#plot!.dispatchEvent(new PointerEvent("pointermove", { pointerType: "mouse", clientX: e.clientX, clientY: e.clientY }));
      // Marks that share the pointer settle which tip shows on the next frame.
      await nextFrame();
      const value = this.#value;
      if (value && value === before && value.href) location.href = value.href;
      else if (value && !this.#tapped) {
        this.#tapped = true;
        document.addEventListener("pointerdown", this.#outside, { capture: true, passive: true });
      } else if (!value) this.#dismiss();
    }

    #outside = (e: PointerEvent) => {
      if (!this.contains(e.target as Node)) this.#dismiss();
    };

    #dismiss() {
      if (!this.#tapped) return;
      this.#tapped = false;
      document.removeEventListener("pointerdown", this.#outside, { capture: true });
      this.#plot?.dispatchEvent(new PointerEvent("pointerleave", { pointerType: "mouse" }));
    }

    async #render() {
      const width = Math.floor(this.clientWidth);
      if (!this.#visible || !this.#spec || !width || Math.abs(width - this.#width) < 4) return;
      this.#width = width;
      const [Plot, { charts, stripMarkLabels }] = await load();
      const { chart, data } = this.#spec;
      const el = Plot.plot(charts[chart as keyof typeof charts](data as never, { width, interactive: true })) as SVGSVGElement;
      stripMarkLabels(el);
      el.addEventListener("input", () => el.classList.toggle("is-linked", !!this.#value?.href));
      this.#dismiss();
      this.#plot = el;
      this.querySelector(".canvas")!.replaceChildren(el);
      this.#drawn?.();
    }
  }
  customElements.define("plot-chart", PlotChart);
</script>

<style>
  .plot-figure { margin: 0; }
  plot-chart { display: block; min-width: 0; }
  .canvas :global(svg) { display: block; max-width: 100%; height: auto; --plot-background: var(--surface); }
  .canvas :global(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
  .canvas :global(svg.is-linked) { cursor: pointer; }
  .canvas :global(svg a) { text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { .canvas :global(svg a:hover) { text-decoration: underline; } }

  .legend {
    display: flex; gap: 6px 18px; flex-wrap: wrap; list-style: none; padding: 0; margin: 0 0 var(--sp-3);
    font-size: var(--fs-sm); color: var(--text-secondary);
  }
  .key { display: inline-block; width: 10px; height: 10px; margin-right: 6px; vertical-align: -1px; background: var(--key); }
  .key.square { border-radius: 2px; }
  .key.dot { border-radius: 50%; }
  .key.ring { border-radius: 50%; background: transparent; border: 2px solid var(--key); }
  .key.tick { width: 2px; height: 14px; margin: 0 8px 0 4px; vertical-align: -3px; }

  .table-scroll { font-size: var(--fs-sm); }
  .table-scroll table { font-size: var(--fs-sm); }
</style>
