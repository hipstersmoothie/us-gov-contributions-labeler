---
// A ranked table with an inline bar beside each value: the table is the data,
// the bar is just a reading aid, so it stays a real <table> for screen readers.
import { moneyAuto } from "../lib/format";

const PARTY: Record<string, string> = { D: "Democrat", R: "Republican", I: "Independent" };

interface Row {
  label: string;
  href?: string;
  /** Party letter, shown as a lettered tag. */
  party?: string;
  note?: string;
  value: number;
  /** Extra text columns after the name. */
  cells?: string[];
}
interface Props {
  rows: Row[];
  heading: string;
  valueHeading: string;
  extraHeadings?: string[];
  caption?: string;
  /** Show the rank number column. */
  rank?: boolean;
  /** Shared scale when one list is split across tables. */
  max?: number;
}
const { rows, heading, valueHeading, extraHeadings = [], caption, rank = true } = Astro.props;
// Let "Institutions/Investments/Securities" wrap at its slashes.
const breakable = (text: string) => text.replace(/\//g, "/\u200b");
const max = Astro.props.max ?? Math.max(...rows.map((r) => r.value), 1);
---

<table class="ranked">
  {caption && <caption class="visually-hidden">{caption}</caption>}
  <thead>
    <tr>
      {rank && <th class="rank num" scope="col"><span class="visually-hidden">Rank</span></th>}
      <th scope="col">{heading}</th>
      {extraHeadings.map((h) => <th scope="col" class="extra">{h}</th>)}
      <th scope="col" class="value-h">{valueHeading}</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((r, i) => (
        <tr>
          {rank && <td class="rank num">{i + 1}</td>}
          <td class="name">
            {r.party && <span class={`ptag party-${r.party}`} title={PARTY[r.party]}><span aria-hidden="true">{r.party}</span><span class="visually-hidden">{PARTY[r.party]}</span></span>}
            {r.href ? <a href={r.href}>{r.label}</a> : r.label}
            {r.note && <span class="note">{breakable(r.note)}</span>}
          </td>
          {r.cells?.map((c) => <td class="extra">{c}</td>)}
          <td class:list={["num", "value", { em: r.value === max }]}>
            <div class="cell">
              <span class="amount">{moneyAuto(r.value)}</span>
              <span class="bar" style={`--w: ${Math.max(r.value / max, 0.004)}`} aria-hidden="true" />
            </div>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  /* Rank, name and amount share the first line's baseline, however the name wraps. */
  .ranked td { padding-top: 9px; padding-bottom: 9px; vertical-align: baseline; }
  .ranked th { vertical-align: bottom; }
  .rank { width: 2.4em; padding-right: 14px; color: var(--text-muted); font-size: var(--fs-sm); }
  .name { font-weight: 500; }
  .note { display: block; font-size: var(--fs-sm); font-weight: 400; color: var(--text-muted); margin-top: 1px; }
  .extra { color: var(--text-secondary); font-size: 13px; }
  .value { width: 46%; }
  .value-h { width: 46%; }
  .cell { display: inline-flex; align-items: baseline; gap: 10px; width: 100%; }
  .amount { flex: none; width: 58px; text-align: right; }
  .bar {
    flex: none; align-self: center; height: 10px; width: calc((100% - 68px) * var(--w));
    background: var(--bar); border-radius: 0 2px 2px 0; /* square at the baseline */
  }
  .em .bar { background: var(--bar-strong); }
  @media (max-width: 640px) {
    .extra { display: none; }
    .value, .value-h { width: 38%; }
  }
</style>
