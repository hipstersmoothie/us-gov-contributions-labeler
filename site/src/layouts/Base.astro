---
import "../styles/global.css";
import "../styles/controls.css";
import SiteSearch from "../islands/SiteSearch";
import Logo from "../components/Logo.astro";

import { generatedAt, cycleRange } from "../lib/data";
import { ogImage, type OgType } from "../lib/og";
import { breadcrumbs, SITE_NAME } from "../lib/seo";

interface Props {
  title: string;
  description?: string;
  /** The page's link-preview card (see lib/og.ts), rendered on request. */
  og?: { type: OgType; id: string };
  /** A static 1200×630 card for a page without an og card, e.g. /bluesky/. */
  card?: { src: string; alt: string };
  ogType?: "website" | "article" | "profile";
  /** Where the page sits, after Home: [name, path] pairs, the last being this page. */
  crumbs?: [string, string][];
  /** schema.org JSON-LD for the page (see lib/seo.ts). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Kept out of search results: the 404 page, search results. */
  noindex?: boolean;
}
const { title, description, og, card, ogType = "article", crumbs, jsonLd, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const NAV = [
  ["/members/", "Members"],
  ["/organizations/", "Organizations"],
  ["/sectors/", "Sectors"],
  ["/committees/", "Committees"],
  ["/bills/", "Bills"],
  ["/revolving-door/", "Revolving door"],
  ["/foreign-lobbying/", "Foreign lobbying"],
  ["/holdings/", "Investments"],
  ["/travel/", "Travel"],
  ["/donors/", "Big donors"],
  ["/bluesky/", "On Bluesky"],
];
const isHome = title === "Home";
const TAGLINE = "Who funds your member of Congress?";
const fullTitle = isHome ? `${TAGLINE} · ${SITE_NAME}` : `${title} · ${SITE_NAME}`;
// The word joiner that keeps "2021–2026" together on the page is noise in a
// link preview, so meta text drops it.
const desc = (
  description ?? `Campaign finance for every member of Congress: PAC money by industry, organization and committee, ${cycleRange}.`
).replace(/\u2060/g, "");
// No canonical on a noindex page: the 404 page answers for every missing URL.
const canonical = Astro.site && !noindex ? new URL(path, Astro.site).href : undefined;
const cardTitle = isHome ? `${SITE_NAME}: ${TAGLINE}` : title;
const structured = [...[jsonLd ?? []].flat(), ...(crumbs?.length ? [breadcrumbs(crumbs)] : [])];
// "<" can't appear raw in a script element's JSON.
const ld = (data: unknown) => JSON.stringify(data).replace(/</g, "\\u003c");
// The page's own 1200×630 card: rendered on request by site/server, or a
// static one; otherwise the site card from design/og/og-card.html.
const site = Astro.site ?? new URL("https://contributions.fyi");
const preview = (og && ogImage(og.type, og.id)) || card;
const imageUrl = new URL(preview?.src ?? "/og.png", site).href;
const imageAlt = preview?.alt ?? "contributions.fyi: who funds your member of Congress? With every House seat colored by party.";
const updated = generatedAt.toLocaleDateString("en-US", { dateStyle: "long" });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={cardTitle} />
    <meta name="twitter:title" content={cardTitle} />
    <meta name="twitter:description" content={desc} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={isHome ? "website" : ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <!-- The two faces every page sets text in; see the @font-face notes in global.css. -->
    <link rel="preload" href="/fonts/libre-franklin-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {structured.map((data) => <script type="application/ld+json" set:html={ld(data)} />)}
    <!-- Privacy-friendly analytics by Plausible: no cookies, aggregate counts only. Proxied
         through site/server (/v/), so blocklists that match plausible.io don't drop it. -->
    <script is:inline async src="/v/s.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init({ endpoint: "/v/e", outboundLinks: true, fileDownloads: true });
    </script>
    <noscript><style>.disclosure-panel[hidden] { display: block !important; } .disclosure-trigger .chevron { display: none; }</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap masthead-row">
        <a class="brand" href="/">
          <Logo />
          <span class="visually-hidden">contributions.fyi</span>
        </a>
        <SiteSearch client:load />
      </div>
      <nav class="sections" aria-label="Sections">
        <ul class="wrap">
          {
            NAV.map(([href, text]) => (
              <li>
                <a href={href} aria-current={path.startsWith(href!) ? "page" : undefined}>{text}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <a href="/" aria-label={`${SITE_NAME}, home`}><Logo /></a>
          <p class="footer-tagline">Who funds <em>your</em> member of Congress?</p>
        </div>
        <p>
          PAC contributions to current members of Congress, {cycleRange}, from{" "}
          <a href="https://www.fec.gov/data/browse-data/?tab=bulk-data">FEC filings</a>. Industries from{" "}
          <a href="https://www.sec.gov/edgar">SEC EDGAR</a> and <a href="https://lda.gov/">lobbying disclosures</a>; foreign
          agents from <a href="https://efile.fara.gov/">FARA filings</a>.
          Data as of {updated}. Labels on Bluesky from{" "}
          <a href="https://bsky.app/profile/contributions.fyi">@contributions.fyi</a>.
        </p>
        <p class="footer-links"><a href="/about/">How this data works</a> · <a href="/open-data/">Open data</a></p>
      </div>
    </footer>
  </body>
</html>
