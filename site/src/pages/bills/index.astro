---
import Base from "../../layouts/Base.astro";
import BillsTable from "../../islands/BillsTable";
import { bills, congress, lobbyingSpan, ordinal } from "../../lib/legislation";
import { billRows } from "../../lib/rows";

const rows = billRows();
const policyAreas = [...new Set(rows.map((r) => r.policyArea).filter(Boolean))].sort();
const laws = bills.filter((b) => b.law).length;
const votes = bills.flatMap((b) => b.votes);
const share = (p: string) => Math.round((100 * votes.filter((v) => v.pattern === p).length) / Math.max(votes.length, 1));
---

<Base
  title={`Bills the ${ordinal(congress)} Congress voted on: party votes and lobbying`}
  og={{ type: "page", id: "bills" }}
  description={`All ${bills.length} bills and resolutions the ${ordinal(congress)} Congress held a recorded vote on passing, ${laws} of them now law: how each party voted, and which organizations reported lobbying on them.`}
  crumbs={[["Bills", "/bills/"]]}
>
  <p class="kicker">Bills</p>
  <h1>What Congress voted on</h1>
  <p class="dek">
    Every bill and resolution the House or Senate held a recorded vote on passing in the {ordinal(congress)} Congress:{" "}
    <strong>{bills.length}</strong> so far, <strong>{laws}</strong> of them now law. Each page shows how the parties
    voted and which organizations reported lobbying on it from {lobbyingSpan}.
  </p>
  <p class="chart-dek">
    Of {votes.length} passage votes, {share("party-line")}% were <strong>party-line</strong> (90% or more of each party
    on opposite sides), {share("near-unanimous")}% <strong>near-unanimous</strong>, and {share("split")}%{" "}
    <strong>split</strong>, with at least one party divided.
  </p>
  <BillsTable
    client:idle
    initial={[...rows].sort((a, b) => b.lastVote.localeCompare(a.lastVote)).slice(0, 100)}
    src="/data/bills.json"
    policyAreas={policyAreas}
  />
</Base>
