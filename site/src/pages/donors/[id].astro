---
import Base from "../../layouts/Base.astro";
import RankedTable from "../../components/RankedTable.astro";
import OutsideTable from "../../components/OutsideTable.astro";
import {
  donors,
  committeeById,
  memberById,
  money,
  partyLetter,
  displayName,
  committeeLabel,
  committeeHref,
  cycleRange,
  MIN_DONATION,
  type Donor,
} from "../../lib/data";
import { chamberName } from "../../lib/derived";
import { clip, listOf } from "../../lib/seo";

export function getStaticPaths() {
  // Donors that share a name (people in different states, a committee filed
  // two ways) get what tells them apart in the title: their state, then their
  // type, then the FEC id.
  const counter = (key: (d: Donor) => string) => {
    const n = new Map<string, number>();
    for (const d of donors) n.set(key(d), (n.get(key(d)) ?? 0) + 1);
    return (d: Donor) => n.get(key(d))!;
  };
  const byName = counter((d) => d.name);
  const byState = counter((d) => `${d.name}|${d.state}`);
  const byType = counter((d) => `${d.name}|${d.state}|${d.type}`);
  const which = (d: Donor) =>
    byName(d) > 1
      ? [d.state, byState(d) > 1 && d.type, byType(d) > 1 && /^c\d{8}$/.test(d.id) && `FEC ${d.id.toUpperCase()}`].filter(Boolean).join(", ")
      : "";
  return donors.map((d) => ({ params: { id: d.id }, props: { d, which: which(d) } }));
}

const { d, which } = Astro.props as { d: Donor; which: string };

// What the groups they funded spent on members. Shown per group, never
// attributed to the donor: money is fungible inside a super PAC.
const funded = d.gifts.map((g) => ({ gift: g, committee: committeeById.get(g.id) }));
const about =
  d.type === "individual"
    ? [d.occupation, d.employer, d.state].filter(Boolean).join(" · ")
    : d.type === "committee"
      ? "Political committee"
      : "Organization";

const path = `/donors/${d.id}/`;
const groups = d.gifts.length === 1 ? "one super PAC or outside group" : `${d.gifts.length} super PACs and outside groups`;
const description = clip(
  `${d.name}${about && d.type === "individual" ? ` (${about.replaceAll(" · ", ", ")})` : ""} gave ${money(d.total, true)} to ${groups} ` +
    `that spent on members of Congress, ${cycleRange.replace("–", " to ")}, including ${listOf(d.gifts.slice(0, 2).map((g) => committeeLabel(g.id)))}.`
);
---

<Base
  title={`${d.name}${which ? ` (${which})` : ""}: donations to super PACs and outside groups`}
  og={{ type: "donor", id: d.id }}
  {description}
  crumbs={[["Big donors", "/donors/"], [d.name, path]]}
>
  <p class="kicker"><a href="/donors/">Big donors</a></p>
  <h1>{d.name}</h1>
  <p class="dek">{about}</p>
  {d.organization && <p>See also <a href={`/organizations/${d.organization}/`}>{d.name}'s PAC giving</a>.</p>}
  {d.committee && <p>See also <a href={`/pacs/${d.committee}/`}>this committee's profile</a>.</p>}

  <dl class="stats">
    <div class="stat"><dt>Given to outside spenders, {cycleRange}</dt><dd>{money(d.total, true)}</dd></div>
    <div class="stat"><dt>Groups funded</dt><dd>{d.gifts.length}</dd></div>
  </dl>

  <section class="card section">
    <h2>Donations</h2>
    <p class="muted small">Individual donations of {money(MIN_DONATION)} or more, as reported by the receiving committee.</p>
    <RankedTable
      heading="Group"
      valueHeading="Given"
      rows={funded.map(({ gift, committee }) => ({
        label: committeeLabel(gift.id),
        value: gift.total,
        href: committeeHref(gift.id),
        note: Object.keys(gift.byCycle).map((c) => `${Number(c) - 1}–${c.slice(2)}`).join(", "),
      }))}
    />
  </section>

  {
    funded.map(({ gift, committee }) =>
      committee?.outside ? (
        <section class="card section">
          <h2>What {displayName(committee.name)} spent on current members</h2>
          <OutsideTable
            heading="Member"
            rows={committee.outside.targets.slice(0, 10).map((t) => {
              const m = memberById.get(t.id);
              return { label: m?.name ?? t.id, href: `/members/${t.id}/`, party: m ? partyLetter(m.party) : undefined, note: m ? `${chamberName(m)}, ${m.state}` : undefined, support: t.support, oppose: t.oppose };
            })}
          />
          {committee.outside.targets.length > 10 && (
            <p class="small"><a href={`/pacs/${gift.id}/`}>All {committee.outside.targets.length} members</a></p>
          )}
        </section>
      ) : null
    )
  }
</Base>
