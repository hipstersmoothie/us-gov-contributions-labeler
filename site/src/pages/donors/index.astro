---
import Base from "../../layouts/Base.astro";
import DonorsTable from "../../islands/DonorsTable";
import { donors, money, cycleRange, MIN_DONATION } from "../../lib/data";
import { donorRows } from "../../lib/rows";
---

<Base
  title="Big donors: who funds the super PACs"
  og={{ type: "page", id: "donors" }}
  description={`${donors.length.toLocaleString()} people, companies and committees that gave ${money(MIN_DONATION)} or more in all to a super PAC or other group spending for or against members of Congress, ${cycleRange.replace("–", " to ")}.`}
  crumbs={[["Big donors", "/donors/"]]}
>
  <p class="kicker">Big donors</p>
  <h1>Who funds the super PACs</h1>
  <p class="dek">
    {donors.length.toLocaleString()} people, companies and committees that gave {money(MIN_DONATION)} or more in all
    to super PACs and other groups that spent for or against current members of Congress, {cycleRange}.
  </p>
  <DonorsTable client:idle initial={donorRows().slice(0, 100)} src="/data/donors.json" />
</Base>
