---
import Base from "../layouts/Base.astro";
import PlotFigure from "../components/PlotFigure.astro";
import RankedTable from "../components/RankedTable.astro";
import { sectors } from "../lib/sectors";
import { members, organizations, committees, donors, money, cycles, cycleRange, displayName, partyLetter } from "../lib/data";
import { PARTY_COLOR } from "../lib/charts";
import { memberPoints, topIds, pacTotal, inEvery, pct, shortSeat, chamberName } from "../lib/derived";
import { shortSector } from "../lib/format";
import { website } from "../lib/seo";

const total = sectors.reduce((s, x) => s + x.total, 0);
const byPacMoney = members
  .map((m) => ({ m, total: pacTotal(m) }))
  .sort((a, b) => b.total - a.total);
const onBluesky = members.filter((m) => m.accounts.length).length;
const outsideSpenders = committees
  .filter((c) => c.outside)
  .map((c) => ({ c, spent: c.outside!.support + c.outside!.oppose }))
  .sort((a, b) => b.spent - a.spent);
const outsideTotal = outsideSpenders.reduce((s, x) => s + x.spent, 0);

const median = (xs: number[]) => [...xs].sort((a, b) => a - b)[Math.floor(xs.length / 2)] ?? 0;
// PAC money alone makes the House look better funded than the Senate.
// Senators raise far more overall, mostly from individual donors, so compare
// what each chamber raised and the share PACs made up.
const raised = (m: (typeof members)[number]) => Object.values(m.totals).reduce((s, t) => s + t.receipts, 0);
const chamber = (c: "house" | "senate") => {
  const ms = members.filter((m) => m.chamber === c && raised(m) > 0);
  return {
    pac: median(ms.map(pacTotal)),
    raised: median(ms.map(raised)),
    share: Math.round(median(ms.map((m) => pacTotal(m) / raised(m))) * 100),
  };
};
const house = chamber("house");
const senate = chamber("senate");
const latest = cycles.at(-1)!;
const currentCycle = `${latest - 1}–${String(latest).slice(2)}`;

const points = memberPoints();
const lanes = ["House", "Senate"];

// The sectors that lean hardest each way, among those big enough to matter.
const real = sectors.filter((s) => !["Unknown", "Party & Candidate Committees"].includes(s.name));
const top = real[0]!;
const lean = (s: (typeof sectors)[number]) => s.split.Republican / Math.max(s.total, 1);
const sizable = real.filter((s) => s.total > total * 0.02);
const mostR = [...sizable].sort((a, b) => lean(b) - lean(a))[0]!;
const mostD = [...sizable].sort((a, b) => lean(a) - lean(b))[0]!;

const PARTY_SERIES = [
  { key: "D", label: "To Democrats", color: PARTY_COLOR.D, ink: "var(--on-d)" },
  { key: "I", label: "To independents", color: PARTY_COLOR.I, ink: "var(--on-i)" },
  { key: "R", label: "To Republicans", color: PARTY_COLOR.R, ink: "var(--on-r)" },
];
---

<Base
  title="Home"
  description={`PACs gave ${money(total, true)} to the ${members.length} current members of Congress from ${cycleRange.replace("–", " to ")}. See who funds yours: PAC money by industry, organization and committee, from FEC filings.`}
  jsonLd={website()}
>
  <p class="kicker">contributions.fyi · PAC money, {cycleRange}</p>
  <h1 class="tagline">Who funds <em>your</em> member of Congress?</h1>
  <p class="dek">
    PACs and other committees gave <strong>{money(total, true)}</strong> to the {members.length} current members of
    Congress from {cycleRange.replace("–", " to ")}. <strong>{top.name}</strong> gave the most, {inEvery(top.total / total)}.
    The typical House member took <strong>{money(house.pac, true)}</strong> from PACs, about {house.share}% of what they
    raised. The typical senator took less, <strong>{money(senate.pac, true)}</strong>, but raised far more overall
    ({money(senate.raised, true)} to {money(house.raised, true)}), so PACs paid for only about {senate.share}% of their
    campaigns.
  </p>

  <dl class="stats">
    <div class="stat"><dt>PAC &amp; committee money</dt><dd>{money(total, true)}</dd></div>
    <div class="stat"><dt>Outside spending, for &amp; against</dt><dd>{money(outsideTotal, true)}</dd></div>
    <div class="stat"><dt>Organizations traced</dt><dd>{organizations.length.toLocaleString()}</dd></div>
    <div class="stat"><dt>Members on Bluesky</dt><dd><a href="/about/#labeler">{onBluesky}</a></dd></div>
  </dl>

  <section class="story">
    <h2>Every member of Congress, by the PAC money they took</h2>
    <p class="chart-dek">
      Each dot is one member, placed by total contributions from PACs and other committees, {cycleRange}. Senators
      raise more than House members overall, but mostly from individual donors, so they tend to sit lower here.
      Figures for {currentCycle} are still being reported to the FEC.
    </p>
    <PlotFigure
      chart="swarm"
      label="Beeswarm of every member of Congress by PAC money received, colored by party"
      data={{ points, lanes, labels: topIds(points, 3, lanes), medians: true, xLabel: "PAC money" }}
      legend={[
        { label: "Democrat", color: PARTY_COLOR.D, shape: "dot" },
        { label: "Republican", color: PARTY_COLOR.R, shape: "dot" },
        { label: "Independent", color: PARTY_COLOR.I, shape: "dot" },
      ]}
      table={{
        columns: ["Member", "Party", "Chamber", "PAC money"],
        numeric: [3],
        rows: byPacMoney.map(({ m, total }) => [{ text: m.name, href: `/members/${m.bioguide}/` }, m.party, chamberName(m), money(total)]),
      }}
    />
  </section>

  <section class="story">
    <h2>Where the money comes from</h2>
    <p class="chart-dek">
      PAC money by the sector of the organization behind it, split by the party of the member who got it.{" "}
      {shortSector(mostD.name)} money went <strong>{pct(mostD.split.Democrat, mostD.total)}%</strong> to Democrats;{" "}
      {shortSector(mostR.name).toLowerCase()} money went <strong>{pct(mostR.split.Republican, mostR.total)}%</strong> to Republicans.
    </p>
    <PlotFigure
      chart="stacked"
      label="PAC money by sector, split by recipient party"
      legend={PARTY_SERIES.map((s) => ({ label: s.label, color: s.color }))}
      data={{
        mode: "amount",
        series: PARTY_SERIES,
        rows: sectors.map((s) => ({
          label: s.name,
          href: `/sectors/${s.slug}/`,
          values: { D: s.split.Democrat, I: s.split.Independent, R: s.split.Republican },
          note: s.split.Republican >= s.split.Democrat ? `${pct(s.split.Republican, s.total)}% R` : `${pct(s.split.Democrat, s.total)}% D`,
        })),
      }}
      table={{
        columns: ["Sector", "To Democrats", "To independents", "To Republicans", "Total"],
        numeric: [1, 2, 3, 4],
        rows: sectors.map((s) => [s.name, money(s.split.Democrat), money(s.split.Independent), money(s.split.Republican), money(s.total)]),
      }}
    />
  </section>

  <div class="grid-2">
    <section class="story">
      <h2>The biggest givers</h2>
      <p class="chart-dek">Organizations whose PACs gave the most to current members.</p>
      <RankedTable
        heading="Organization"
        valueHeading="Given"
        rows={organizations.slice(0, 12).map((o) => ({ label: o.name, value: o.total, href: `/organizations/${o.id}/`, note: o.sector }))}
      />
      <p class="source"><a href="/organizations/">All organizations</a></p>
    </section>

    <section class="story">
      <h2>The biggest takers</h2>
      <p class="chart-dek">Members who received the most from PACs and other committees.</p>
      <RankedTable
        heading="Member"
        valueHeading="Received"
        rows={byPacMoney.slice(0, 12).map(({ m, total }) => ({
          label: m.name,
          party: partyLetter(m.party),
          value: total,
          href: `/members/${m.bioguide}/`,
          note: `${m.party}, ${chamberName(m)}, ${shortSeat(m).slice(2)}`,
        }))}
      />
      <p class="source"><a href="/members/">All members</a></p>
    </section>
  </div>

  <div class="grid-2">
    <section class="story">
      <h2>Outside spenders</h2>
      <p class="chart-dek">Super PACs and other groups' ads for and against current members.</p>
      <RankedTable
        heading="Group"
        valueHeading="Spent"
        rows={outsideSpenders.slice(0, 10).map(({ c, spent }) => ({ label: displayName(c.name), value: spent, href: `/pacs/${c.id}/` }))}
      />
    </section>
    <section class="story">
      <h2>Who funds the outside spenders</h2>
      <p class="chart-dek">The biggest donors to those groups.</p>
      <RankedTable
        heading="Donor"
        valueHeading="Given"
        rows={donors.slice(0, 10).map((d) => ({ label: d.name, value: d.total, href: `/donors/${d.id}/`, note: d.type === "individual" ? d.employer : d.type }))}
      />
      <p class="source"><a href="/donors/">All big donors</a></p>
    </section>
  </div>
</Base>
