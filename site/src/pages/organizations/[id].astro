---
import Base from "../../layouts/Base.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import RankedTable from "../../components/RankedTable.astro";
import MoreDisclosure from "../../islands/MoreDisclosure";
import Chambers from "../../components/Chambers.astro";
import { PARTY_COLOR } from "../../lib/charts";
import { recipientPoints, pct, chamberName } from "../../lib/derived";
import { moneyAuto } from "../../lib/format";
import { organizationBills, lobbyingSpan } from "../../lib/legislation";
import StaffTable from "../../components/StaffTable.astro";
import LazyDisclosure from "../../islands/LazyDisclosure";
import { officialsByOrg, filingSpan, STAFF_SHOWN } from "../../lib/revolving";
import {
  registrantsByOrg,
  principalsByRegistrant,
  principalsByOrg,
  registrantById,
  countryById,
  faraGifts,
  faraDocsUrl,
  faraSince,
  monthYear,
} from "../../lib/fara";
import "../../styles/lobbying.css";
import {
  organizations,
  committeeById,
  memberById,
  MIN_DONATION,
  money,
  partyLetter,
  partySplit,
  sectorSlug,
  cycleRange,
  displayName,
  committeeLabel,
  committeeHref,
  kindLabel,
  type Organization,
} from "../../lib/data";

export function getStaticPaths() {
  return organizations.map((o) => ({ params: { id: o.id }, props: { o } }));
}

const { o } = Astro.props as { o: Organization };
const split = partySplit(o.recipients);
const pacs = o.committees.map((id) => committeeById.get(id)).filter((c) => !!c);
const issues = o.lobbying?.issues.slice(0, 10) ?? [];
const name = o.name.startsWith("The ") ? o.name : o.name.match(/^(National|American|International)\b/) ? `The ${o.name}` : o.name;

// Plain-language summary: party lean, and what a typical gift looked like.
const amounts = o.recipients.map((r) => r.total).sort((a, b) => a - b);
const q = (f: number) => amounts[Math.floor((amounts.length - 1) * f)] ?? 0;
const repShare = pct(split.Republican, o.total);
const demShare = pct(split.Democrat, o.total);
const leanText =
  Math.abs(repShare - demShare) <= 6
    ? `It split its money almost evenly between the parties`
    : repShare > demShare
      ? `${repShare}% went to Republicans`
      : `${demShare}% went to Democrats`;
const topRecipient = memberById.get(o.recipients[0]?.id ?? "");

const points = recipientPoints(o.recipients);
// Parties with only a handful of recipients would get a near-empty lane of
// their own; they're named in a note below the chart instead.
const MIN_LANE = 5;
const laneCount = (l: string) => points.filter((p) => p.lane === l).length;
const lanes = ["Democrats", "Republicans", "Independents"].filter((l) => laneCount(l) >= MIN_LANE);
const leftOut = points.filter((p) => !lanes.includes(p.lane)).sort((a, b) => b.value - a.value);
const PARTY_SERIES = [
  { key: "D", label: "Democrats", color: PARTY_COLOR.D, ink: "var(--on-d)" },
  { key: "I", label: "Independents", color: PARTY_COLOR.I, ink: "var(--on-i)" },
  { key: "R", label: "Republicans", color: PARTY_COLOR.R, ink: "var(--on-r)" },
];
const byChamber = (ch?: "house" | "senate") => {
  const v = { D: 0, I: 0, R: 0 };
  for (const r of o.recipients) {
    const m = memberById.get(r.id);
    if (m && (!ch || m.chamber === ch)) v[partyLetter(m.party) as keyof typeof v] += r.total;
  }
  return v;
};
const splitRows = [
  { label: "All recipients", values: byChamber() },
  { label: "House", values: byChamber("house") },
  { label: "Senate", values: byChamber("senate") },
].filter((r) => r.values.D + r.values.I + r.values.R > 0);

// Bills its lobbying reports name, most often named first.
const lobbiedBills = organizationBills[o.id] ?? [];
const BILLS_SHOWN = 12;
// Former government officials lobbying for it (or, for a firm, on its staff).
const officials = officialsByOrg.get(o.id) ?? [];
const firm = !!o.lobbying?.firm;

// Registered under FARA: the foreign principals it represents, and its agents' donations.
const faraRegs = registrantsByOrg.get(o.id) ?? [];
const faraIds = new Set(faraRegs.map((r) => r.id));
const represented = faraRegs.flatMap((r) => principalsByRegistrant.get(r.id) ?? []);
const activePrincipals = represented.filter((p) => !p.terminated).sort((a, b) => b.registered.localeCompare(a.registered));
const endedPrincipals = represented.filter((p) => p.terminated).sort((a, b) => b.terminated!.localeCompare(a.terminated!));
const agentRecipients = Object.entries(faraGifts)
  .map(([id, gifts]) => ({ id, total: gifts.filter((g) => faraIds.has(g.registrant)).reduce((s, g) => s + g.total, 0) }))
  .filter((r) => r.total > 0)
  .sort((a, b) => b.total - a.total);
const agentTotal = agentRecipients.reduce((s, r) => s + r.total, 0);
const PRINCIPALS_SHOWN = 12;
// Matched through its PAC ("Akin Gump ... Civic Action Committee"): the firm is the registrant.
const viaPac = /\b(PAC|Committee|Political Action)\b/i.test(o.name);
// It's a foreign principal: the US agents registered to represent it.
const asPrincipal = principalsByOrg.get(o.id) ?? [];

const secUrl = o.sec && `https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${o.sec.cik}`;
---

<Base title={o.name} og={{ type: "organization", id: o.id }} description={`Which members of Congress ${o.name} funds, ${cycleRange}.`}>
  <p class="kicker">
    <a href={`/sectors/${sectorSlug(o.sector)}/`}>{o.sector}</a>
    {o.industry && <> · {o.industry}</>}
  </p>
  <h1>{o.name}</h1>
  <p class="dek">
    {name}{o.name.endsWith("PAC") ? "" : o.name.endsWith("s") ? "' PAC" : "'s PAC"} gave <strong>{money(o.total, true)}</strong> to{" "}
    <strong>{o.recipients.length}</strong> current members of Congress from {cycleRange.replace("–", " to ")}. {leanText}.{" "}
    {amounts.length > 4 && <>The typical member got between {money(q(0.25), true)} and {money(q(0.75), true)}</>}
    {topRecipient && <>; {topRecipient.name} got the most, {money(o.recipients[0]!.total, true)}</>}.
  </p>

  <dl class="stats">
    <div class="stat"><dt>Given to current members</dt><dd>{money(o.total, true)}</dd></div>
    <div class="stat"><dt>Members funded</dt><dd>{o.recipients.length}</dd></div>
    {o.employees && <div class="stat"><dt>From its employees</dt><dd>{money(o.employees.total, true)}</dd></div>}
    {o.lobbyingSpend && <div class="stat"><dt>Spent lobbying</dt><dd>{money(o.lobbyingSpend.total, true)}</dd></div>}
    {o.sec && <div class="stat"><dt>Ticker</dt><dd><a href={secUrl}>{o.sec.ticker}</a></dd></div>}
  </dl>

  <section class="story">
    <h2>Who it reached</h2>
    <p class="chart-dek">
      Every seat in Congress. The members {o.name} gave to, {cycleRange}, are in their party's color; everyone else is
      gray. Hover or tap a seat for the amount.
    </p>
    <Chambers recipients={o.recipients} giver={name} />
  </section>

  <section class="story">
    <h2>Which party got the money</h2>
    <p class="chart-dek">Contributions split by the recipient's party, overall and in each chamber.</p>
    <PlotFigure
      chart="stacked"
      label="Contributions by recipient party and chamber"
      legend={PARTY_SERIES.filter((s) => splitRows.some((r) => r.values[s.key as "D"] > 0)).map((s) => ({ label: s.label, color: s.color }))}
      data={{ mode: "share", series: PARTY_SERIES, rows: splitRows }}
      table={{
        columns: ["", "Democrats", "Independents", "Republicans"],
        numeric: [1, 2, 3],
        rows: splitRows.map((r) => [r.label, money(r.values.D), money(r.values.I), money(r.values.R)]),
      }}
    />
  </section>

  {
    lanes.length > 0 && (
      <section class="story">
        <h2>How much each member got</h2>
        <p class="chart-dek">
          Number of members of Congress by the total {o.name} gave them, {cycleRange}. PACs can give a candidate
          $5,000 per election, so totals cluster at round numbers.
        </p>
        <PlotFigure
          chart="histogram"
          label={`How much ${o.name} gave each member, by party`}
          data={{ points: points.filter((p) => lanes.includes(p.lane)), lanes, unit: "members" }}
          table={{
            columns: ["Member", "Party", "Chamber", "Given"],
            numeric: [3],
            rows: o.recipients.flatMap((r) => {
              const m = memberById.get(r.id);
              return m ? [[{ text: m.name, href: `/members/${m.bioguide}/` }, m.party, chamberName(m), money(r.total)]] : [];
            }),
          }}
        >
          {
            leftOut.length > 0 && (
              <p class="source" slot="note">
                Not shown: {leftOut.length === 1 ? "one member" : `${leftOut.length} members`} from parties with fewer than{" "}
                {MIN_LANE} recipients:{" "}
                {leftOut.slice(0, 4).map((p, i) => (
                  <>{i > 0 && "; "}<a href={p.href}>{p.name}</a> ({p.party}), {money(p.value, true)}</>
                ))}
                {leftOut.length > 4 && `; and ${leftOut.length - 4} more in the table view`}.
              </p>
            )
          }
        </PlotFigure>
      </section>
    )
  }

  <div class="grid-2">
    <section class="story">
      <h2>Top recipients</h2>
      <p class="chart-dek">The members {o.name} gave the most.</p>
      <RankedTable
        heading="Member"
        valueHeading="Given"
        rows={o.recipients.slice(0, 15).map((r) => {
          const m = memberById.get(r.id);
          return {
            label: m?.name ?? r.id,
            value: r.total,
            href: `/members/${r.id}/`,
            party: m ? partyLetter(m.party) : undefined,
            note: m ? `${chamberName(m)}, ${m.state}` : undefined,
          };
        })}
      />
      {
        o.recipients.length > 15 && (
          <MoreDisclosure client:visible title={`All ${o.recipients.length.toLocaleString()} recipients`}>
            <table>
              <caption class="visually-hidden">Every member {o.name} gave to</caption>
              <tbody>
                {o.recipients.map((r) => {
                  const m = memberById.get(r.id);
                  return (
                    <tr>
                      <td>
                        {m && <span class={`ptag party-${partyLetter(m.party)}`} title={m.party}>{partyLetter(m.party)}</span>}
                        <a href={`/members/${r.id}/`}>{m?.name ?? r.id}</a>
                        {m && <span class="muted small"> · {chamberName(m)}, {m.state}</span>}
                      </td>
                      <td class="num">{moneyAuto(r.total)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </MoreDisclosure>
        )
      }
    </section>

    <section class="story">
      <h2>{pacs.length === 1 ? "Its PAC" : "Its PACs"}</h2>
      <table>
        <tbody>
          {pacs.map((c) => (
            <tr>
              <td><a href={`/pacs/${c.id}/`}>{displayName(c.name)}</a><div class="muted small">{kindLabel(c.kind)} · {c.id}</div></td>
              <td class="num">{money(c.total, true)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {
        o.outsideGifts && (
          <>
            <h3 class="kicker gap">Gifts to super PACs</h3>
            <p class="muted small">Donations of {money(MIN_DONATION)} or more to groups that spent on current members.</p>
            <table>
              <tbody>
                {o.outsideGifts.map((g) => (
                  <tr>
                    <td><a href={committeeHref(g.id)}>{committeeLabel(g.id)}</a></td>
                    <td class="num">{money(g.total, true)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        )
      }
      <h3 class="kicker gap">What it lobbies on</h3>
      {
        o.lobbyingSpend && (
          <p class="small">
            Spent {money(o.lobbyingSpend.total)} on federal lobbying{" "}
            ({Object.entries(o.lobbyingSpend.byYear).map(([y, v], i) => <>{i > 0 && ", "}{y}: {money(v, true)}</>)}).
          </p>
        )
      }
      {o.lobbying?.description && <p class="small">{o.lobbying.description}</p>}
      {
        issues.length ? (
          <ul class="chips">{issues.map((i) => <li class="chip">{i.name}</li>)}</ul>
        ) : (
          <p class="empty-note">
            {o.lobbying?.firm
              ? `${o.name} is registered as a lobbying firm, so its filings list clients rather than issues of its own.`
              : `No federal lobbying disclosures matched ${o.name}. Many PAC sponsors lobby through trade groups, or not at all.`}
          </p>
        )
      }
      {
        o.lobbying && (
          <p class="source">
            From <a href="https://lda.gov/filings/public/filing/search/">lobbying disclosures</a> filed
            for {displayName(o.lobbying.client)}.
          </p>
        )
      }
      {
        o.sec && (
          <p class="source">
            SEC: <a href={secUrl}>{o.sec.name}</a>{o.sec.sicDescription && <>, {o.sec.sicDescription} (SIC {o.sec.sic})</>}
          </p>
        )
      }
    </section>
  </div>

  {
    o.bundled && (
      <section class="story">
        <h2>Contributions its lobbyists bundled</h2>
        <p class="chart-dek">
          {o.bundled.bundlers.length === 1 ? o.bundled.bundlers[0]!.name : `${o.bundled.bundlers.length} of its lobbyists or its PAC`}{" "}
          collected <strong>{money(o.bundled.total, true)}</strong> from other donors and passed it to current members'
          campaigns and leadership PACs, {cycleRange}, as the campaigns reported on FEC Form 3L. Bundlers are matched to{" "}
          {name} by name.
        </p>
        <RankedTable
          heading="Member"
          valueHeading="Bundled"
          rows={o.bundled.recipients.slice(0, 15).map((r) => {
            const m = memberById.get(r.id);
            return { label: m?.name ?? r.id, value: r.total, href: `/members/${r.id}/`, party: m ? partyLetter(m.party) : undefined, note: m ? `${chamberName(m)}, ${m.state}` : undefined };
          })}
        />
        {o.bundled.bundlers.length > 1 && (
          <p class="source">Bundlers: {o.bundled.bundlers.map((b) => `${b.name} (${money(b.total, true)})`).join(", ")}.</p>
        )}
      </section>
    )
  }

  {
    lobbiedBills.length > 0 && (
      <section class="story">
        <h2>Bills it lobbied on</h2>
        <p class="chart-dek">
          Bills of this Congress named in lobbying reports filed for {name}, {lobbyingSpan}, by how many quarterly
          reports named them. Reports list what was lobbied on, not the position taken; "Said" is filled in only where
          the report states one.
        </p>
        <table class="org-bills">
          <thead>
            <tr>
              <th scope="col">Bill</th>
              <th scope="col" class="num">Reports</th>
              <th scope="col">Said</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {lobbiedBills.slice(0, BILLS_SHOWN).map((ob) => (
              <tr>
                <td>
                  {ob.page ? <a href={`/bills/${ob.id}/`}>{ob.name}</a> : ob.name}
                  <span class="muted small"> · {ob.label}</span>
                </td>
                <td class="num">{ob.quarters}</td>
                <td class="small">{ob.stance === "support" ? "Supports" : ob.stance === "oppose" ? "Opposes" : <span class="muted">—</span>}</td>
                <td class="small">{ob.law ? `Law (${ob.law})` : ob.page ? "Voted on" : <span class="muted">No passage vote</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
        {lobbiedBills.length > BILLS_SHOWN && (
          <MoreDisclosure client:visible title={`All ${lobbiedBills.length}${lobbiedBills.length === 60 ? "+" : ""} bills`}>
            <ul class="all-bills">
              {lobbiedBills.slice(BILLS_SHOWN).map((ob) => (
                <li>
                  {ob.page ? <a href={`/bills/${ob.id}/`}>{ob.name}</a> : ob.name}
                  <span class="muted small"> · {ob.label}, {ob.quarters} report{ob.quarters === 1 ? "" : "s"}</span>
                </li>
              ))}
            </ul>
          </MoreDisclosure>
        )}
        <p class="source">
          Matched by the bill numbers written in each report. <a href="/about/#bills">How bills are matched</a>.
        </p>
      </section>
    )
  }

  {
    officials.length > 0 && (
      <section class="story" id="former-officials">
        <h2>{firm ? "Former government officials on its lobbying staff" : "Former government officials lobbying for it"}</h2>
        <p class="chart-dek">
          Lobbyists list the government jobs they held in the 20 years before they began lobbying for a client.{" "}
          {officials.length === 1 ? "One lobbyist" : `${officials.length} lobbyists`}{" "}
          {firm ? `registered by ${name}` : `lobbying for ${name}`} on filings from {filingSpan} listed one or more, in
          Congress or the executive branch. Where a job names a current member or committee, it's linked.
        </p>
        <StaffTable rows={officials.slice(0, STAFF_SHOWN)} links except={o.id} caption={`Former government officials lobbying for ${o.name}`} />
        {officials.length > STAFF_SHOWN && (
          <LazyDisclosure client:visible title={`${officials.length - STAFF_SHOWN} more lobbyists`} src={`/fragments/organizations/${o.id}/officials/`} />
        )}
        <p class="source">
          From registrations and quarterly reports on <a href="https://lda.gov/">lda.gov</a>, as the lobbyists wrote them.{" "}
          <a href="/about/#revolving-door">How jobs are matched</a>.
        </p>
      </section>
    )
  }

  {
    faraRegs.length > 0 && (
      <section class="story" id="foreign-agent">
        <h2>Registered as a foreign agent</h2>
        <p class="chart-dek">
          {viaPac ? <>{faraRegs[0]!.name}, the firm behind this PAC,</> : name} is registered under the Foreign Agents Registration Act
          {faraRegs.map((r, i) => (
            <>{i > 0 ? " and" : ""} (<a href={faraDocsUrl(r.id)}>No. {r.id}</a>, since {monthYear(r.registered)}{r.terminated && `, ended ${monthYear(r.terminated)}`})</>
          ))}{" "}
          to represent foreign governments, parties or companies in the US.{" "}
          {activePrincipals.length > 0
            ? <>It lists <strong>{activePrincipals.length}</strong> foreign principal{activePrincipals.length === 1 ? "" : "s"} now.</>
            : <>It lists no foreign principals now.</>}
        </p>
        {activePrincipals.length > 0 && (
          <table class="principals">
            <thead><tr><th scope="col">Foreign principal</th><th scope="col">Country</th><th scope="col">Since</th></tr></thead>
            <tbody>
              {activePrincipals.slice(0, PRINCIPALS_SHOWN).map((p) => (
                <tr>
                  <td>{p.name}</td>
                  <td><a href={`/foreign-lobbying/${p.country}/`}>{countryById.get(p.country)?.name}</a></td>
                  <td class="small">{monthYear(p.registered)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        {(activePrincipals.length > PRINCIPALS_SHOWN || endedPrincipals.length > 0) && (
          <MoreDisclosure client:visible title={activePrincipals.length > PRINCIPALS_SHOWN ? `All ${activePrincipals.length} current principals, and ${endedPrincipals.length} that ended` : `${endedPrincipals.length} that ended since ${faraSince.slice(0, 4)}`}>
            <table class="principals">
              <tbody>
                {[...activePrincipals.slice(PRINCIPALS_SHOWN), ...endedPrincipals].map((p) => (
                  <tr>
                    <td>{p.name}</td>
                    <td><a href={`/foreign-lobbying/${p.country}/`}>{countryById.get(p.country)?.name}</a></td>
                    <td class="small">{p.terminated ? `Ended ${monthYear(p.terminated)}` : `Since ${monthYear(p.registered)}`}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </MoreDisclosure>
        )}
        {agentRecipients.length > 0 && (
          <>
            <h3 class="kicker gap">Its agents' donations</h3>
            <p class="small">
              People registered as {viaPac ? "the firm's" : "its"} foreign agents gave <strong>{money(agentTotal, true)}</strong> to{" "}
              {agentRecipients.length} current member{agentRecipients.length === 1 ? "" : "s"}' campaigns while registered,{" "}
              {cycleRange}, per FEC records. FARA doesn't tie these to a client.
            </p>
            <RankedTable
              heading="Member"
              valueHeading="Given"
              rows={agentRecipients.slice(0, 10).map((r) => {
                const m = memberById.get(r.id);
                return { label: m?.name ?? r.id, value: r.total, href: `/members/${r.id}/#foreign-agents`, party: m ? partyLetter(m.party) : undefined, note: m ? `${chamberName(m)}, ${m.state}` : undefined };
              })}
            />
          </>
        )}
        <p class="source">
          From FARA registrations on <a href="https://efile.fara.gov/">efile.fara.gov</a>. <a href="/foreign-lobbying/">Foreign lobbying by country</a>.
        </p>
      </section>
    )
  }

  {
    asPrincipal.length > 0 && (
      <section class="story" id="foreign-principal">
        <h2>Represented by registered foreign agents</h2>
        <p class="chart-dek">
          {asPrincipal[0]!.name} is listed as a foreign principal on{" "}
          {asPrincipal.length === 1 ? "a FARA registration" : `${asPrincipal.length} FARA registrations`} in effect since{" "}
          {faraSince.slice(0, 4)}: US firms or people registered to represent it.
        </p>
        <table class="principals">
          <thead><tr><th scope="col">Registered agent</th><th scope="col">Country</th><th scope="col">Registration</th></tr></thead>
          <tbody>
            {asPrincipal.map((p) => {
              const r = registrantById.get(p.registrant);
              return (
                <tr>
                  <td><a href={faraDocsUrl(p.registrant)}>{r?.name ?? p.registrant}</a></td>
                  <td><a href={`/foreign-lobbying/${p.country}/`}>{countryById.get(p.country)?.name}</a></td>
                  <td class="small">{p.terminated ? `${monthYear(p.registered)} to ${monthYear(p.terminated)}` : `Since ${monthYear(p.registered)}`}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>
    )
  }

  {
    o.employees && (
      <section class="story">
        <h2>Donations from its employees</h2>
        <p class="chart-dek">
          Itemized donations from people who listed {o.name} as their employer, to current members' campaigns,{" "}
          {cycleRange}. These are personal donations, separate from the PAC.
        </p>
        <RankedTable
          heading="Member"
          valueHeading="Donated"
          rows={o.employees.recipients.slice(0, 10).map((r) => {
            const m = memberById.get(r.id);
            return { label: m?.name ?? r.id, value: r.total, href: `/members/${r.id}/`, party: m ? partyLetter(m.party) : undefined, note: m ? `${chamberName(m)}, ${m.state}` : undefined };
          })}
        />
      </section>
    )
  }
</Base>

<style>
  .gap { margin-top: 28px; }
  .org-bills td:last-child { white-space: nowrap; }
  .principals td:last-child { white-space: nowrap; color: var(--text-muted); }
  .all-bills { columns: 2 280px; column-gap: var(--sp-6); padding: 0; margin: 0; list-style: none; font-size: var(--fs-sm); line-height: 1.8; }
</style>
