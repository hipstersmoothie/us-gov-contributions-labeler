---
import Base from "../../layouts/Base.astro";
import OrganizationsTable from "../../islands/OrganizationsTable";
import { money, cycleRange } from "../../lib/data";
import { orgRows, ORG_MIN } from "../../lib/rows";
import { SECTORS } from "../../../../src/lib/sectors.ts";

const rows = orgRows();
---

<Base title="Organizations" og={{ type: "page", id: "organizations" }} description="The companies, unions and groups whose PACs fund Congress.">
  <p class="kicker">Organizations</p>
  <h1>Who's behind the PACs</h1>
  <p class="dek">
    The companies, unions, trade groups and causes behind PACs giving to current members, {cycleRange}. Showing the{" "}
    {rows.length.toLocaleString()} that gave at least {money(ORG_MIN)}; the rest are in search.
  </p>
  <OrganizationsTable client:idle initial={rows.slice(0, 100)} src="/data/organizations.json" sectors={[...SECTORS]} />
</Base>
