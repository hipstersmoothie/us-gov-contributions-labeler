---
// An index of what House members reported owning and trading.
import Base from "../../layouts/Base.astro";
import TradesTable from "../../islands/TradesTable";
import { memberById, partyLetter } from "../../lib/data";
import { disclosures, companies, companyName, tradeRows, COMPANY_KINDS } from "../../lib/holdings";

const rows = tradeRows();
const all = [...disclosures.entries()].filter(([id]) => memberById.has(id));
// Annual reports with assets on the site: e-filed, or read from the scan.
const parsed = all.filter(([, d]) => d.annual && (!d.annual.paper || d.annualScanned));
const paper = all.filter(([, d]) => d.annual?.paper || d.ptrs.some((p) => p.paper));
const traders = new Set(rows.map((r) => r.bioguide));
const lags = rows.map((r) => r.lagDays).sort((a, b) => a - b);
const median = lags[Math.floor(lags.length / 2)] ?? 0;
const after45 = lags.filter((l) => l > 45).length;
const ptrs = all.reduce((s, [, d]) => s + d.ptrs.length, 0);
const companyRows = rows.filter((r) => r.company).length;
const scanned = rows.filter((r) => r.scanned).length;
const unread = all.reduce((s, [, d]) => s + (d.scanUnread ?? 0), 0);

// Most widely held: how many members reported each company. This is mostly a
// picture of the market itself.
const widest = [...companies.values()]
  .map((c) => ({ c, n: c.holders.length }))
  .sort((a, b) => b.n - a.n)
  .slice(0, 12);
const withCompanyStock = parsed.filter(([, d]) => d.holdings.some((h) => COMPANY_KINDS.includes(h.kind))).length;
---

<Base title="What members own and trade" description="House members' reported investments and stock trades, from their financial disclosure reports. Values are ranges.">
  <p class="kicker">Investments</p>
  <h1>What members own and trade</h1>
  {all.length === 0 && <p class="empty-note">This build doesn't include the disclosure data.</p>}
  <p class="dek">
    Members of Congress report what they, their spouses and dependent children own each May, and any stock trade over
    $1,000 within 45 days. These are <strong>{parsed.length} House members' 2025 annual reports</strong> and{" "}
    <strong>{rows.length.toLocaleString()} trades</strong> from {ptrs.toLocaleString()} transaction reports since
    January 2025. {scanned.toLocaleString()} of the trades were read by machine from members' scanned paper forms and are
    marked as such. Senators aren't included yet.
  </p>

  <dl class="stats">
    <div class="stat"><dt>Members with single-company stock</dt><dd>{withCompanyStock}<small>of {parsed.length} with a 2025 annual report</small></dd></div>
    <div class="stat"><dt>Members who reported trades</dt><dd>{traders.size}<small>since January 2025</small></dd></div>
    <div class="stat"><dt>Typical wait to report</dt><dd>{median} days<small>after the trade</small></dd></div>
    <div class="stat"><dt>Reported after 45 days</dt><dd>{Math.round((after45 / rows.length) * 100)}%<small>{after45.toLocaleString()} trades, including amendments</small></dd></div>
  </dl>

  <section class="story how">
    <h2>How to read these</h2>
    <ul>
      <li><strong>Every value is a range.</strong> Members pick a category, like $1,001–$15,000; a total is the sum of the low ends to the sum of the high ends.</li>
      <li><strong>Whose it is matters.</strong> Each holding and trade says whether it's the member's, their spouse's, joint, or a dependent child's. Reports don't say who chose a trade; a few members add a note that an adviser did.</li>
      <li><strong>Funds aren't companies.</strong> A mutual fund, ETF or retirement account is listed by name only, so it isn't counted toward any company or industry here. Fund trades don't have to be reported at all.</li>
      <li><strong>Owning isn't a conflict.</strong> A stock in an industry a member's committee oversees is worth knowing about; it isn't evidence that it changed anything they did.</li>
    </ul>
  </section>

  <section class="story">
    <h2>Every trade</h2>
    <TradesTable client:idle initial={rows.slice(0, 25)} src="/holdings/trades.json" />
    <p class="source">{companyRows.toLocaleString()} of the trades are a single company's stock, options or bonds; switch to Everything to see the rest.</p>
  </section>

  <div class="grid-2">
    <section class="story">
      <h2>Most widely held companies</h2>
      <p class="chart-dek">How many members reported owning each company's stock at the end of 2025. It mostly mirrors the stock market: the largest companies are in the most portfolios.</p>
      <table>
        <thead><tr><th scope="col">Company</th><th scope="col">Industry</th><th scope="col" class="num">Members</th></tr></thead>
        <tbody>
          {widest.map(({ c, n }) => (
            <tr><td><a href={`/holdings/companies/${c.cik}/`}>{companyName(c.name)}</a></td><td class="muted">{c.sector}</td><td class="num">{n}</td></tr>
          ))}
        </tbody>
      </table>
    </section>
    <section class="story">
      <h2>Filed on paper</h2>
      <p class="chart-dek">
        The House posts these as scanned images. Their trades are read by machine and checked against each form's grid;{" "}
        {unread.toLocaleString()} rows that couldn't be read reliably are left out. Their annual reports are read the same
        way, except handwritten pages and attached brokerage statements.
      </p>
      <ul class="link-list paper">
        {paper.map(([id, d]) => {
          const m = memberById.get(id)!;
          const p = partyLetter(m.party);
          const url = d.annual?.paper ? d.annual.url : d.ptrs.find((x) => x.paper)?.url;
          return (
            <li>
              <span class={`ptag party-${p}`}>{p}</span>
              <a href={url}>{m.name}</a>
              <span class="muted small"> {d.annual?.paper ? "annual report" : ""}{d.annual?.paper && d.ptrs.some((x) => x.paper) ? " and " : ""}{d.ptrs.filter((x) => x.paper).length ? `${d.ptrs.filter((x) => x.paper).length} transaction reports` : ""}</span>
            </li>
          );
        })}
      </ul>
    </section>
  </div>

  <p class="source">
    Source: <a href="https://disclosures-clerk.house.gov/FinancialDisclosure">U.S. House Clerk financial disclosure reports</a>;
    companies and industries from SEC EDGAR. Under 5 U.S.C. § 13107 these reports may not be used for any commercial
    purpose (other than news media's), to determine a credit rating, or to solicit money for any political, charitable or
    other purpose.
  </p>
</Base>

<style>
  .how ul { margin: 0; padding-left: 1.1em; max-width: 720px; }
  .how li { margin-bottom: var(--sp-2); color: var(--text-secondary); }
  .how li strong { color: var(--text-primary); }
  .paper { list-style: none; padding: 0; margin: 0; columns: 2 220px; }
  .paper li { margin-bottom: var(--sp-2); break-inside: avoid; }
  :global(.nowrap) { white-space: nowrap; }
  :global(.scan-tag) {
    display: inline-block; margin-left: 6px; padding: 0 5px; border: 1px solid var(--hairline); border-radius: 2px;
    font-size: var(--fs-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-secondary);
  }
  /* Member, asset, whose, traded, amount, reported */
  :global(.trades-island .data-table .th:nth-child(1)) { width: 24%; }
  :global(.trades-island .data-table .th:nth-child(2)) { width: auto; }
  :global(.trades-island .data-table .th:nth-child(3)) { width: 10%; }
  :global(.trades-island .data-table .th.num) { width: 12%; }
  @media (max-width: 640px) {
    :global(.trades-island .data-table .th:nth-child(1)) { width: 34%; }
    :global(.trades-island .data-table .th.num) { width: 22%; }
  }
</style>
