---
import Base from "../../layouts/Base.astro";
import MembersTable from "../../islands/MembersTable";
import { members, cycleRange } from "../../lib/data";
import { memberRows } from "../../lib/rows";

const states = [...new Set(members.map((m) => m.state))].sort();
---

<Base title="Members of Congress" og={{ type: "page", id: "members" }} description={`Every current member of Congress, what they raised and how much came from PACs, ${cycleRange}.`}>
  <p class="kicker">Members</p>
  <h1>Members of Congress</h1>
  <p class="dek">
    All {members.length} current members, what their campaigns raised from {cycleRange.replace("–", " to ")}, and how
    much came from PACs and other committees. Sort any column, or filter by chamber, party and state.
  </p>
  <MembersTable client:idle rows={memberRows()} states={states} />
</Base>
