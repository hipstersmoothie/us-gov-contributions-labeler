---
import Base from "../../layouts/Base.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import RankedTable from "../../components/RankedTable.astro";
import InfoPopover from "../../islands/InfoPopover";
import MoreDisclosure from "../../islands/MoreDisclosure";
import {
  members,
  organizationById,
  committeeById,
  congressCommitteeById,
  photoUrl,
  money,
  seat,
  partyLetter,
  sectorSlug,
  cycleRange,
  displayName,
  committeeLabel,
  committeeHref,
  kindLabel,
  fecCandidateUrl,
  spenderType,
  hidesDonors,
  type Member,
} from "../../lib/data";
import { memberPoints, pacPercentile, pacTotal, raisedTotal, chamberName, pct, possessive, backersPhrase, cycleLabel, donorMakeup, makeupShares, chamberMakeupMedians } from "../../lib/derived";
import { STATES } from "../../../../src/lib/list-specs";
import { surname, moneyAuto, candidateName, partyCode } from "../../lib/format";
import OutsideTable from "../../components/OutsideTable.astro";
import VotesTable from "../../components/VotesTable.astro";
import LazyDisclosure from "../../islands/LazyDisclosure";
import { memberVotes, partyPlural, caucusOf, memberCaucusName, VOTES_SHOWN } from "../../lib/legislation";
import { disclosures } from "../../lib/holdings";
import StaffTable from "../../components/StaffTable.astro";
import AgentTable from "../../components/AgentTable.astro";
import { staffByMember, filingSpan, STAFF_SHOWN } from "../../lib/revolving";
import { faraGifts } from "../../lib/fara";
import "../../styles/lobbying.css";
import { clip, memberProfile, office, partyState } from "../../lib/seo";
import TripsTable from "../../components/TripsTable.astro";
import { tripsByMember, summarize, sinceLabel, sponsorByKey, sponsorHref, TRIPS_SHOWN } from "../../lib/travel";

export function getStaticPaths() {
  return members.map((m) => ({ params: { bioguide: m.bioguide }, props: { m } }));
}

const { m } = Astro.props as { m: Member };
const raised = raisedTotal(m);
const fromPacs = pacTotal(m);
const sectorTotal = m.sectors.reduce((s, x) => s + x.total, 0);
const photo = photoUrl(m.bioguide);
const initials = `${m.name[0]}${surname(m.name)[0]}`;
const seats = m.assignments
  .map((a) => ({ ...a, committee: congressCommitteeById.get(a.id) }))
  .filter((a) => a.committee)
  // Full committees first, then their subcommittees.
  .sort((a, b) => Number(!!a.committee!.parent) - Number(!!b.committee!.parent));
const ind = m.individuals;
const contributors = m.contributors ?? [];
const p = partyLetter(m.party);
const last = surname(m.name);
const chamber = chamberName(m);
const peers = chamber === "Senate" ? "senators" : "House members";
const typical = chamber === "Senate" ? "senator" : "House member";

// Plain-language summary.
const fromIndividuals = Object.values(m.totals).reduce((s, t) => s + t.individual, 0);
const rank = pacPercentile(m);
const chamberPac = members.filter((x) => x.chamber === m.chamber).map(pacTotal).sort((a, b) => a - b);
const median = chamberPac[Math.floor(chamberPac.length / 2)] ?? 0;
const comparison =
  Math.abs(fromPacs - median) < median * 0.05
    ? `about what the typical ${typical} took`
    : `${fromPacs > median ? "more than" : "less than"} the ${money(median, true)} the typical ${typical} took`;
const backers = backersPhrase(m);
const topPacSector = m.sectors.find((s) => !["Unknown", "Party & Candidate Committees"].includes(s.id));
const topCombined = (m.combinedSectors ?? []).find((s) => !["Unknown", "Party & Candidate Committees", "Retired", "Not employed"].includes(s.id));
const pacsDiffer = backers && topPacSector && topCombined && topPacSector.id !== topCombined.id;
const headline = backers ? `${possessive(last)} biggest backers are ${backers}` : `${last} has reported little money from industry groups`;

// Funding breakdown by cycle, with the in-progress cycle labeled as such.
const SOURCES = [
  { key: "pac", label: "PACs", color: "var(--bar)", ink: "var(--on-bar)" },
  { key: "individual", label: "Individuals", color: "var(--bar-muted)", ink: "var(--on-bar-muted)" },
  { key: "other", label: "Party, self & other", color: "var(--context)", ink: "var(--on-context)" },
];
const cycleRows = Object.entries(m.totals)
  .map(([cycle, t]) => ({
    label: cycleLabel(Number(cycle)),
    values: { individual: t.individual, pac: t.pac, other: Math.max(t.receipts - t.individual - t.pac, 0) },
  }))
  .reverse();
const inProgress = cycleRows.some((r) => r.label.includes("so far"));

const points = memberPoints((x) => x.bioguide === m.bioguide).filter((x) => x.lane === chamber);
const chamberTop = [...points].sort((a, b) => b.value - a.value)[0]!;

// Contributors: each organization's PAC plus its employees.
const CONTRIB = [
  { key: "pacs", label: "Its PAC", color: "var(--bar)", ink: "var(--on-bar)" },
  { key: "individuals", label: "Its employees", color: "var(--bar-muted)", ink: "var(--on-bar-muted)" },
];
const topContributors = contributors.slice(0, 12).map((c) => {
  const org = c.id.startsWith("employer:") ? undefined : organizationById.get(c.id);
  return { c, href: org ? `/organizations/${org.id}/` : undefined };
});
const contribPac = contributors.reduce((s, c) => s + c.pacs, 0);
const contribEmp = contributors.reduce((s, c) => s + c.individuals, 0);

const spenders = m.outside.spenders
  .map((s) => {
    const c = committeeById.get(s.id);
    return { ...s, label: committeeLabel(s.id), kind: spenderType(s.id), nonCommittee: c?.kind === "non-committee", hidden: hidesDonors(c), href: committeeHref(s.id) };
  })
  .sort((a, b) => b.support + b.oppose - (a.support + a.oppose));
// Groups that aren't PACs, and those of them whose filings name no donors.
const byNonCommittee = spenders.filter((s) => s.nonCommittee).reduce((n, s) => n + s.support + s.oppose, 0);
const byHidden = spenders.filter((s) => s.hidden).reduce((n, s) => n + s.support + s.oppose, 0);
const ec = m.electioneering;
// Lobbyist PACs we have a page for go by the name used everywhere else on the site.
const bundlerName = (b: { name: string; committee?: string }) => (b.committee && committeeById.has(b.committee) ? committeeLabel(b.committee) : b.name);

// Who gave: small vs. itemized, where itemized donors live, and the
// candidate's own money, each against the chamber's median member.
const makeup = donorMakeup(m);
const shares = makeup && makeupShares(makeup);
const medians = chamberMakeupMedians(m.chamber);
const stateName = STATES[m.state] ?? m.state;
const pctOf = (v: number | undefined) => (v === undefined ? "–" : `${Math.round(v * 100)}%`);
const self = makeup ? makeup.selfGiven + makeup.selfLoans : 0;
const makeupRows = makeup
  ? [
      {
        label: "Individual donations, by size",
        segments: [
          { label: "small donors ($200 or less)", value: makeup.small, color: "var(--bar)", ink: "var(--on-bar)" },
          { label: "larger, itemized donations", value: makeup.itemized, color: "var(--bar-muted)", ink: "var(--on-bar-muted)" },
        ],
        median: medians.small,
        medianLabel: `Median ${typical}: ${pctOf(medians.small)} from small donors`,
      },
      ...(makeup.inDistrict !== undefined || makeup.restOfState + makeup.outOfState > 0
        ? [
            {
              label: "Itemized donations, by where the donor lives",
              segments: [
                ...(makeup.inDistrict !== undefined
                  ? [
                      { label: "in the district", value: makeup.inDistrict, color: "var(--bar)", ink: "var(--on-bar)" },
                      { label: `elsewhere in ${stateName}`, value: makeup.restOfState, color: "var(--bar-muted)", ink: "var(--on-bar-muted)" },
                    ]
                  : [{ label: `in ${stateName}`, value: makeup.restOfState, color: "var(--bar)", ink: "var(--on-bar)" }]),
                { label: "out of state", value: makeup.outOfState, color: "var(--context)", ink: "var(--on-context)" },
              ],
              median: medians.inState,
              medianLabel: `Median ${typical}: ${pctOf(medians.inState)} from in state`,
            },
          ]
        : []),
      ...(shares?.self && shares.self >= 0.005
        ? [
            {
              label: "Everything the campaign raised",
              segments: [
                { label: "the candidate's own money", value: self, color: "var(--bar)", ink: "var(--on-bar)" },
                { label: "everyone else", value: Math.max(makeup.receipts - self, 0), color: "var(--context)", ink: "var(--on-context)" },
              ],
              median: medians.self,
              medianLabel: `Median ${typical}: ${pctOf(medians.self)} of their own money`,
            },
          ]
        : []),
    ]
  : [];

// Spending on their opponents (other candidates in the same race), kept apart
// from spending that named the member.
const opp = m.opponents ?? { support: 0, oppose: 0, spenders: [], candidates: [] };
const oppCandidates = opp.candidates.map((c) => {
  const letter = partyCode(c.party);
  return {
    ...c,
    label: `${candidateName(c.name)}${letter ? ` (${letter})` : c.party ? ` (${c.party})` : ""}`,
    race: c.office === "S" ? `Senate, ${c.state}` : `House, ${c.state}${c.district ? `-${c.district}` : ""}`,
  };
});

// Passage votes, and where they broke with their party.
const votes = memberVotes(m);
const decided = votes.filter((x) => x.position !== "O");
const broke = votes.filter((x) => x.broke);
const withParty = decided.filter((x) => x.t && (x.position === "Y" ? x.t.yes >= x.t.no : x.t.no >= x.t.yes)).length;
// Independents are compared with the party they caucus with.
const caucusLetter = caucusOf(m);
const caucus = memberCaucusName(m);
const hasDisclosure = disclosures.has(m.bioguide);

// Former staff now lobbying, and registered foreign agents who gave.
const staff = staffByMember.get(m.bioguide) ?? [];
const houseStaff = m.chamber === "senate" && staff.some((x) => x.note);
const agentGifts = faraGifts[m.bioguide] ?? [];
const agentTotal = agentGifts.reduce((s, g) => s + g.total, 0);

const path = `/members/${m.bioguide}/`;
const title = `${m.name} (${partyState(m)}): campaign money, top donors and industries`;
const description = clip(
  `${m.name}, ${office(m)}` +
    (raised > 0
      ? `, raised ${money(raised, true)} from ${cycleRange.replace("–", " to ")}, ${money(fromPacs, true)} of it from PACs. `
      : `. `) +
    `${headline}. Top contributors, PAC money by industry, outside spending and votes.`
);

// Trips outside groups paid for, by the member or their staff.
const memberTrips = tripsByMember.get(m.bioguide) ?? [];
const travel = summarize(memberTrips);
const tripSponsorRows = [...memberTrips.reduce((acc, t) => {
  for (const k of t.sponsors) acc.set(k, (acc.get(k) ?? 0) + 1);
  return acc;
}, new Map<string, number>())]
  .map(([k, n]) => ({ s: sponsorByKey.get(k)!, n }))
  .filter((r) => r.s)
  .sort((a, b) => b.n - a.n || a.s.name.localeCompare(b.s.name));
const ethics = m.chamber === "senate" ? "Senate Ethics Committee" : "House Ethics Committee";

---

<Base
  {title}
  {description}
  og={{ type: "member", id: m.bioguide }}
  ogType="profile"
  crumbs={[["Members", "/members/"], [m.name, path]]}
  jsonLd={memberProfile(m, path)}
>
  <header class="member-head">
    {
      photo ? (
        <img src={photo} alt={`Official portrait of ${m.name}`} width="104" height="128" />
      ) : (
        <div class="portrait-empty" aria-hidden="true">{initials}</div>
      )
    }
    <div>
      <p class="kicker"><span class={`ptag party-${p}`}>{p}</span>{m.party}{caucusLetter && <> · caucuses with {partyPlural(caucusLetter)}</>} · {seat(m)}</p>
      <h1>{m.name}</h1>
    </div>
  </header>

  <p class="headline-summary">{headline}.</p>
  <p class="dek">
    {
      raised > 0 ? (
        <>
          {last} raised <strong>{money(raised, true)}</strong> from {cycleRange.replace("–", " to ")},{" "}
          {pct(fromIndividuals, raised)}% of it from individual donors. PACs and other committees gave{" "}
          <strong>{money(fromPacs, true)}</strong>, {comparison}.
        </>
      ) : (
        <>
          The FEC has no campaign summaries on file for {last} for {cycleRange}.{" "}
          {fromPacs > 0 && <>PAC filings still show <strong>{money(fromPacs, true)}</strong> in contributions.</>}
        </>
      )
    }
  </p>

  <dl class="stats">
    <div class="stat">
      <dt>
        Raised, {cycleRange}
        <InfoPopover client:visible title="What counts as raised">
          <p>Total receipts the campaign reported to the FEC across the {cycleRange} cycles: individual donations, PAC and party money, and the candidate's own funds.</p>
          {inProgress && <p>The current cycle is still under way, so its totals will grow.</p>}
        </InfoPopover>
      </dt>
      <dd>{raised > 0 ? money(raised, true) : "–"}</dd>
    </div>
    <div class="stat">
      <dt>
        From PACs &amp; committees
        <InfoPopover client:visible title="PAC and committee money">
          <p>Direct contributions from PACs, leadership PACs and party and candidate committees, as itemized in FEC filings.</p>
          <p>Ranked against all {rank.of} {peers}.</p>
        </InfoPopover>
      </dt>
      <dd>{money(fromPacs, true)}<small>No. {rank.rank} of {rank.of} in the {chamber}</small></dd>
    </div>
    <div class="stat"><dt>Outside spending for</dt><dd>{m.outside.support > 0 ? money(m.outside.support, true) : "–"}</dd></div>
    <div class="stat"><dt>Outside spending against</dt><dd>{m.outside.oppose > 0 ? money(m.outside.oppose, true) : "–"}</dd></div>
    {opp.support > 0 && <div class="stat"><dt>Spent supporting their opponents</dt><dd>{money(opp.support, true)}</dd></div>}
  </dl>

  {
    (seats.length > 0 || m.accounts.length > 0) && (
      <section class="meta" aria-label="Committees and accounts">
        {seats.length > 0 && (
          <div>
            <h2 class="kicker">Committees</h2>
            <ul class="chips">
              {seats.map((a) => (
                <li>
                  <a class="chip" href={`/committees/${a.id}/`}>
                    {a.committee!.parent ? `${congressCommitteeById.get(a.committee!.parent)?.name.replace(/^(House|Senate) Committee on (the )?/, "")}: ` : ""}
                    {a.committee!.name.replace(/^(House|Senate|Joint) Committee on (the )?/, "")}
                    {a.title && <strong> · {a.title}</strong>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {m.accounts.length > 0 && (
          <div>
            <h2 class="kicker">On Bluesky</h2>
            <ul class="chips">
              {m.accounts.map((a) => <li><a class="chip" href={`https://bsky.app/profile/${a.handle}`}>@{a.handle}</a></li>)}
            </ul>
          </div>
        )}
      </section>
    )
  }

  {
    hasDisclosure && (
      <p class="investments-link">
        <a href={`/members/${m.bioguide}/investments/`}>What {last} reported owning and trading</a>
        <span class="muted"> · from House financial disclosures</span>
      </p>
    )
  }

  <div class="grid-2">
    <section class="story">
      <h2>Where the money came from</h2>
      {
        cycleRows.length ? (
          <>
            <p class="chart-dek">Everything the campaign raised, by source and election cycle.</p>
            <PlotFigure
              chart="stacked"
              width={500}
              label="Money raised by election cycle and source"
              legend={SOURCES.map((s) => ({ label: s.label, color: s.color }))}
              data={{ mode: "amount", insideLabels: true, series: SOURCES, rows: cycleRows }}
              table={{
                columns: ["Cycle", ...SOURCES.map((s) => s.label)],
                numeric: [1, 2, 3],
                rows: cycleRows.map((r) => [r.label, money(r.values.pac), money(r.values.individual), money(r.values.other)]),
              }}
            />
            <p class="source">
              {inProgress && <>The current cycle is still under way, so its totals are partial. </>}
              Source: FEC candidate summaries,{" "}
              {m.fecIds.map((id, i) => (<>{i > 0 && ", "}<a href={fecCandidateUrl(id)}>{id}</a></>))}
            </p>
          </>
        ) : (
          <p class="empty-note">
            No FEC campaign summaries are on file for {m.name} for {cycleRange}. New members, and members who haven't
            filed in these cycles, have none yet.
          </p>
        )
      }
    </section>

    <section class="story">
      <h2>PAC money by industry</h2>
      {
        m.sectors.length ? (
          <>
            <p class="chart-dek">
              Contributions from PACs, grouped by the industry of the organization behind each one.
              {pacsDiffer && <> Counting PACs alone, {topPacSector!.id.toLowerCase()} leads; the summary above also counts donations from employees.</>}
            </p>
            <PlotFigure
              chart="bars"
              width={500}
              label="PAC money by sector"
              data={{
                rows: m.sectors.slice(0, 8).map((s) => ({ label: s.id, value: s.total, href: `/sectors/${sectorSlug(s.id)}/` })),
                emphasize: [0],
                total: sectorTotal,
              }}
              table={{ columns: ["Sector", "Amount"], numeric: [1], rows: m.sectors.map((s) => [s.id, money(s.total)]) }}
            />
          </>
        ) : (
          <p class="empty-note">No PAC contributions to {last} are on file for {cycleRange}.</p>
        )
      }
    </section>
  </div>

  {
    makeup && shares && (
      <section class="story">
        <h2>Small donors, home state and self-funding</h2>
        <p class="chart-dek">
          Small donors gave <strong>{pctOf(shares.small)}</strong> of {possessive(last)} individual donations, against{" "}
          {pctOf(medians.small)} for the median {typical}.
          {shares.inState !== undefined && (
            <>
              {" "}Of the itemized donations, <strong>{pctOf(shares.inState)}</strong> came from people in {stateName}
              {shares.inDistrict !== undefined && <>, {pctOf(shares.inDistrict)} from inside the district</>} (median{" "}
              {typical}: {pctOf(medians.inState)} in state).
            </>
          )}{" "}
          {self > 0 ? (
            <>
              {last} put <strong>{money(self, true)}</strong> of their own money into the campaign
              {makeup.selfLoans > 0 && makeup.selfGiven > 0
                ? <> ({money(makeup.selfGiven, true)} given, {money(makeup.selfLoans, true)} lent)</>
                : makeup.selfLoans > 0 ? <> as loans</> : null}
              .
            </>
          ) : (
            <>{last} reported no contributions or loans of their own.</>
          )}
        </p>
        <PlotFigure
          chart="makeup"
          label={`${possessive(m.name)} donors by size and home state, with the median ${typical}`}
          legend={[{ label: `Median ${typical}`, color: "var(--text-primary)", shape: "tick" }]}
          data={{ rows: makeupRows }}
          table={{
            columns: ["", last, `Median ${typical}`],
            numeric: [1, 2],
            rows: [
              ["Small donors ($200 or less)", `${money(makeup.small)} (${pctOf(shares.small)})`, pctOf(medians.small)],
              ["Itemized donations", money(makeup.itemized), "–"],
              ...(makeup.inDistrict !== undefined ? [["Itemized, from in the district (estimate)", `${money(makeup.inDistrict)} (${pctOf(shares.inDistrict)})`, pctOf(medians.inDistrict)]] : []),
              ["Itemized, from in state", `${money((makeup.inDistrict ?? 0) + makeup.restOfState)} (${pctOf(shares.inState)})`, pctOf(medians.inState)],
              ["Itemized, from out of state", money(makeup.outOfState), "–"],
              ["Candidate's own contributions", money(makeup.selfGiven), "–"],
              ["Candidate's own loans", money(makeup.selfLoans), "–"],
              ["Own money, share of everything raised", pctOf(shares.self), pctOf(medians.self)],
            ],
          }}
        />
        <p class="source">
          {cycleRange.replace("–", " to ")}. Small and itemized totals are what the campaigns reported to the FEC; where
          donors live comes from the address on each itemized donation.
          {makeup.inDistrict !== undefined && <> The district share is an estimate from ZIP codes: a ZIP that crosses district lines is split by land area, using the Census Bureau's map of today's districts.</>}{" "}
          Loans can be repaid later.
        </p>
      </section>
    )
  }

  <section class="story">
    <h2>How {last} compares</h2>
    <p class="chart-dek">
      PAC and committee money to every member of the {chamber}, {cycleRange}. {last} is highlighted; each gray dot is
      another member.
    </p>
    <PlotFigure
      chart="swarm"
      label={`${m.name}'s PAC money compared with every ${chamber} member`}
      data={{ points, lanes: [chamber], labels: [m.bioguide, ...(chamberTop.id === m.bioguide ? [] : [chamberTop.id])], medians: true, context: true, xLabel: "PAC money" }}
      legend={[
        { label: `${m.name} (${m.party})`, color: `var(--party-${p.toLowerCase()})`, shape: "dot" },
        { label: `Other ${peers}`, color: "var(--context)", shape: "dot" },
      ]}
      table={{
        columns: ["Rank", "Member", "Party", "PAC money"],
        numeric: [0, 3],
        rows: [...points]
          .sort((a, b) => b.value - a.value)
          .map((pt, i) => [i + 1, { text: pt.id === m.bioguide ? `${pt.name} (this page)` : pt.name, href: pt.href! }, pt.detail.split(",")[0]!, money(pt.value)]),
      }}
    />
  </section>

  {
    votes.length > 0 && (
      <section class="story">
        <h2>How {last} votes</h2>
        <p class="chart-dek">
          On the {votes.length} votes on passing a bill that {last} took part in this Congress, {last} voted with most{" "}
          {caucus} {withParty} times of {decided.length}
          {broke.length > 0 ? (
            <>, and broke with them {broke.length === 1 ? "once" : `${broke.length} times`}: siding with a quarter of the party or less.</>
          ) : (
            <>, and never sided with a quarter of the party or less.</>
          )}{" "}
          {caucusLetter && `As an independent who caucuses with ${caucus}, ${last} is compared with them. `}
          The last column counts organizations whose lobbying reports name each bill, on any side of it.
        </p>
        {broke.length > 0 && (
          <>
            <h3>Where {last} broke with {caucus}</h3>
            <VotesTable rows={broke.slice(0, VOTES_SHOWN)} member={last} caucus={caucus} />
            {broke.length > VOTES_SHOWN && (
              <LazyDisclosure client:visible title={`${broke.length - VOTES_SHOWN} more votes against most ${caucus}`} src={`/fragments/members/${m.bioguide}/broke/`} />
            )}
          </>
        )}
        <h3 class:list={{ spaced: broke.length > 0 }}>Most recent votes</h3>
        <VotesTable rows={votes.slice(0, VOTES_SHOWN)} member={last} caucus={caucus} />
        {votes.length > VOTES_SHOWN && (
          <LazyDisclosure client:visible title={`${votes.length - VOTES_SHOWN} earlier votes`} src={`/fragments/members/${m.bioguide}/votes/`} />
        )}
        <p class="source">
          Recorded votes on passing bills and resolutions, from the House Clerk and the Senate. <a href="/bills/">Every bill</a>.
        </p>
      </section>
    )
  }

  {
    topContributors.length > 0 && (
      <section class="story">
        <h2>Top contributors</h2>
        <p class="chart-dek">
          Each organization's PAC plus donations from its employees. Across{" "}
          {possessive(last)} top {contributors.length} contributors, PACs gave <strong>{money(contribPac, true)}</strong> and
          employees <strong>{money(contribEmp, true)}</strong>.
        </p>
        <PlotFigure
          chart="stacked"
          label="Top contributors, split into PAC and employee giving"
          legend={CONTRIB.map((s) => ({ label: s.label, color: s.color }))}
          data={{
            mode: "amount",
            series: CONTRIB,
            rows: topContributors.map(({ c, href }) => ({ label: c.name, href, values: { pacs: c.pacs, individuals: c.individuals } })),
          }}
          table={{
            columns: ["Organization", "PAC", "Employees", "Total"],
            numeric: [1, 2, 3],
            rows: contributors.map((c) => [c.name, money(c.pacs), money(c.individuals), money(c.total)]),
          }}
        />
      </section>
    )
  }

  <section class="story">
    <h2>Outside spending</h2>
    <p class="chart-dek">
      Super PACs and other outside groups can spend unlimited amounts as long as they don't coordinate with a
      campaign. None of it goes to the campaign.
    </p>
    {opp.spenders.length > 0 && <h3 class="part">Spending that named {last}</h3>}
    {
      spenders.length ? (
        <>
          <p class="chart-dek">
            Groups spent <strong>{money(m.outside.support, true)}</strong> supporting {last} and{" "}
            <strong>{money(m.outside.oppose, true)}</strong> opposing them.
            {byNonCommittee > 0 && (
              <>
                {" "}{money(byNonCommittee, true)} of it came from groups that aren't PACs
                {byHidden > 0 && <>, {byHidden === byNonCommittee ? "all" : <>{money(byHidden, true)}</>} from groups whose filings name no donors</>}.
              </>
            )}
          </p>
          <PlotFigure
            chart="diverging"
            label="Outside spending supporting and opposing, by group"
            legend={[
              { label: "Supporting", color: "var(--support)" },
              { label: "Opposing", color: "var(--oppose)" },
            ]}
            data={{ rows: spenders.slice(0, 10).map((s) => ({ label: s.label, href: s.href, support: s.support, oppose: s.oppose })) }}
            table={{
              columns: ["Group", "Type", "Supporting", "Opposing"],
              numeric: [2, 3],
              rows: spenders.map((s) => [{ text: s.label, href: s.href }, s.kind, s.support ? money(s.support) : "–", s.oppose ? money(s.oppose) : "–"]),
            }}
          />
        </>
      ) : (
        <p class="empty-note">No outside groups reported spending for or against {last} by name in {cycleRange}.</p>
      )
    }
    {
      opp.spenders.length > 0 && (
        <>
          <h3 class="part">Spending on their opponents</h3>
          <p class="chart-dek">
            Groups also spent <strong>{money(opp.support, true)}</strong> supporting candidates running against {last}
            {opp.oppose > 0 && <> and <strong>{money(opp.oppose, true)}</strong> opposing those candidates</>}. An
            opponent is another candidate in the same race: in {last}'s party primary, or in a general election {last}{" "}
            was on the ballot for.
          </p>
          <PlotFigure
            chart="diverging"
            label={`Outside spending on ${possessive(last)} opponents, by opponent`}
            legend={[
              { label: "Supporting the opponent", color: "var(--support)" },
              { label: "Opposing the opponent", color: "var(--oppose)" },
            ]}
            data={{ rows: oppCandidates.slice(0, 8).map((c) => ({ label: c.label, support: c.support, oppose: c.oppose })) }}
            table={{
              columns: ["Opponent", "Race", "Supporting", "Opposing"],
              numeric: [2, 3],
              rows: oppCandidates.map((c) => [c.label, c.race, c.support ? money(c.support) : "–", c.oppose ? money(c.oppose) : "–"]),
            }}
          />
          <h4 class="kicker who">Who spent it</h4>
          <OutsideTable
            heading="Group"
            supportHeading="Supporting opponents"
            opposeHeading="Opposing opponents"
            rows={opp.spenders.slice(0, 10).map((s) => {
              const c = committeeById.get(s.id);
              return { label: committeeLabel(s.id), href: committeeHref(s.id), note: c ? spenderType(s.id) : undefined, support: s.support, oppose: s.oppose };
            })}
          />
        </>
      )
    }
    {
      ec && (
        <>
          <h3 class="part">Ads that named {last} without a for or against</h3>
          <p class="chart-dek">
            Groups spent <strong>{money(ec.total, true)}</strong> on electioneering communications naming {last}: broadcast
            ads shortly before an election that mention a candidate but don't say to vote for or against them, so they
            aren't counted as supporting or opposing. Where an ad named several candidates, this is {possessive(last)} share.
          </p>
          <RankedTable
            heading="Group"
            valueHeading="Spent"
            rows={ec.spenders.slice(0, 10).map((s) => ({ label: committeeLabel(s.id), value: s.total, href: committeeHref(s.id), note: spenderType(s.id) || undefined }))}
          />
        </>
      )
    }
  </section>

  {
    m.bundling && (
      <section class="story">
        <h2>Lobbyists who bundled for {last}</h2>
        <p class="chart-dek">
          Registered lobbyists and lobbyists' PACs collected <strong>{money(m.bundling.total, true)}</strong> from other
          donors and passed it to {possessive(last)} campaign{m.bundling.committees.some((id) => committeeById.get(id)?.kind === "leadership-pac") && " or leadership PAC"},{" "}
          {cycleRange}. Campaigns must report a lobbyist's bundles once they pass a threshold, indexed for inflation, in a half-year.
          The money itself is counted with the donors who gave it.
        </p>
        <RankedTable
          heading="Bundler"
          valueHeading="Bundled"
          rows={m.bundling.bundlers.slice(0, 15).map((b) => ({
            label: bundlerName(b),
            href: b.organization ? `/organizations/${b.organization}/` : b.committee && committeeById.has(b.committee) ? `/pacs/${b.committee}/` : undefined,
            note: b.type === "pac" ? "Lobbyist PAC" : [b.occupation ? `Lobbyist, ${b.occupation.toLowerCase()}` : "Lobbyist", b.employer].filter(Boolean).join(" · "),
            value: b.total,
          }))}
        />
        {m.bundling.bundlers.length > 15 && (
          <MoreDisclosure client:visible title={`All ${m.bundling.bundlers.length} bundlers`}>
            <table>
              <tbody>
                {m.bundling.bundlers.map((b) => (
                  <tr>
                    <td>{bundlerName(b)}<span class="muted">{b.employer && <> · {b.employer}</>}</span></td>
                    <td class="num">{moneyAuto(b.total)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </MoreDisclosure>
        )}
        <p class="source">
          Source: FEC Form 3L reports filed by{" "}
          {m.bundling.committees.map((id, i) => (
            <>{i > 0 && ", "}<a href={`https://www.fec.gov/data/filings/?committee_id=${id}&form_type=F3L`}>{committeeLabel(id)}</a></>
          ))}
          . Names link to our organization pages where the employer or PAC matches by name.
        </p>
      </section>
    )
  }

  {
    ind && (
      <div class="grid-2">
        <section class="story">
          <h2>Individual donors by industry</h2>
          <p class="chart-dek">
            Estimated from the employer and occupation on {ind.donations.toLocaleString()} itemized donations
            ({money(ind.itemized, true)}). Donations of $200 or less aren't itemized.
          </p>
          <PlotFigure
            chart="bars"
            width={500}
            label="Itemized individual donations by sector"
            data={{
              rows: ind.sectors.slice(0, 8).map((s) => ({
                label: s.id,
                value: s.total,
                href: ["Retired", "Not employed", "Unknown"].includes(s.id) ? undefined : `/sectors/${sectorSlug(s.id)}/`,
              })),
              total: ind.itemized,
            }}
            table={{ columns: ["Sector", "Amount"], numeric: [1], rows: ind.sectors.map((s) => [s.id, money(s.total)]) }}
          />
        </section>
        <section class="story">
          <h2>Top employers of donors</h2>
          <p class="chart-dek">Itemized donations from people who listed each employer.</p>
          <RankedTable
            heading="Employer"
            valueHeading="Donated"
            rows={ind.employers.slice(0, 10).map((e) => ({
              label: e.organization ? organizationById.get(e.organization)?.name ?? e.name : e.name,
              value: e.total,
              href: e.organization ? `/organizations/${e.organization}/` : undefined,
            }))}
          />
        </section>
      </div>
    )
  }

  <section class="story" id="former-staff">
    {
      staff.length ? (
        <>
          <h2>{staff.length === 1 ? "One former staffer now lobbies" : `${staff.length} former staffers now lobby`}</h2>
          <p class="chart-dek">
            Lobbyists list the government jobs they held in the 20 years before they began lobbying for a client.{" "}
            {staff.length === 1 ? "This person" : `These ${staff.length} people`} listed a job with {last}
            {houseStaff && <>, some from {possessive(last)} years in the House,</>} on lobbying filings from {filingSpan}.
          </p>
          <StaffTable rows={staff.slice(0, STAFF_SHOWN)} caption={`Former staff of ${m.name} who now lobby`} />
          {staff.length > STAFF_SHOWN && (
            <LazyDisclosure client:visible title={`${staff.length - STAFF_SHOWN} more former staffers`} src={`/fragments/members/${m.bioguide}/staff/`} />
          )}
        </>
      ) : (
        <>
          <h2>Former staff who now lobby</h2>
          <p class="empty-note">No lobbyist on filings from {filingSpan} listed a job with {last} that could be matched.</p>
        </>
      )
    }
    <p class="source">
      From registrations and quarterly reports on <a href="https://lda.gov/">lda.gov</a>. Lobbyists write these jobs in their
      own words, so a job counts only when it names {last} and no other current or past member fits; some former staff
      will be missed. <a href="/about/#revolving-door">How jobs are matched</a>.
    </p>
  </section>

  {
    agentGifts.length > 0 && (
      <section class="story" id="foreign-agents">
        <h2>Registered foreign agents who gave</h2>
        <p class="chart-dek">
          {agentGifts.length === 1 ? "One person" : `${agentGifts.length} people`} registered under the Foreign Agents
          Registration Act gave <strong>{money(agentTotal, true)}</strong> to {possessive(last)} campaign while
          registered, {cycleRange}. Agents work for firms that represent foreign governments, parties and companies;
          FARA doesn't tie a donation to any one client, so the countries listed are those their firm's registration covers.
        </p>
        <AgentTable gifts={agentGifts.slice(0, STAFF_SHOWN)} caption={`Registered foreign agents who gave to ${m.name}`} />
        {agentGifts.length > STAFF_SHOWN && (
          <LazyDisclosure client:visible title={`${agentGifts.length - STAFF_SHOWN} more agents`} src={`/fragments/members/${m.bioguide}/agents/`} />
        )}
        <p class="source">
          Agents from FARA short-form registrations on <a href="https://efile.fara.gov/">efile.fara.gov</a>, matched to
          itemized FEC contributions by name and the employer they gave, during their registration. Amounts link to the
          FEC's records. <a href="/about/#foreign-lobbying">How agents are matched</a>.
        </p>
      </section>
    )
  }

  <section class="story" id="travel">
    <h2>Trips paid for by outside groups</h2>
    {
      memberTrips.length > 0 ? (
        <>
          <p class="chart-dek">
            Since {sinceLabel}, outside groups paid for <strong>{travel.trips.toLocaleString()} {travel.trips === 1 ? "trip" : "trips"}</strong>{" "}
            by {last} or staff in {possessive(last)} office
            {travel.byMembers > 0 ? <>; {last} went on {travel.byMembers === travel.trips ? (travel.trips === 1 ? "it" : "all of them") : travel.byMembers}</> : <>; {last} went on none of them</>}.
            {travel.withCost > 0 && (
              <>
                {" "}Sponsors reported spending <strong>{money(travel.cost, true)}</strong> on the{" "}
                {travel.withCost === travel.trips ? "" : `${travel.withCost.toLocaleString()} `}trips whose costs could be read.
              </>
            )}{" "}
            Members and staff may accept travel connected to their official duties when the {ethics} approves it in advance.
          </p>
          {tripSponsorRows.length >= 3 && (
            <PlotFigure
              chart="bars"
              width={640}
              label={`Trips paid for by each sponsor, ${m.name}'s office`}
              data={{ rows: tripSponsorRows.slice(0, 6).map((r) => ({ label: r.s.name, value: r.n, href: sponsorHref(r.s) })), unit: "trips" }}
              table={{ columns: ["Sponsor", "Trips"], numeric: [1], rows: tripSponsorRows.map((r) => [{ text: r.s.name, href: sponsorHref(r.s) }, r.n]) }}
            />
          )}
          <h3 class="spaced">Most recent trips</h3>
          <TripsTable rows={memberTrips.slice(0, TRIPS_SHOWN)} caption={`Trips paid for by outside groups, ${m.name}'s office`} view="member" />
          {memberTrips.length > TRIPS_SHOWN && (
            <LazyDisclosure client:visible title={`${memberTrips.length - TRIPS_SHOWN} earlier trips`} src={`/fragments/members/${m.bioguide}/travel/`} />
          )}
        </>
      ) : (
        <p class="empty-note">No trips paid for by outside groups have been filed for {last} or {possessive(last)} staff since {sinceLabel}.</p>
      )
    }
    <p class="source">
      From the {m.chamber === "senate" ? "Secretary of the Senate's gift rule travel filings" : "House Clerk's gift travel filings"}; costs from each
      sponsor's post-travel form. <a href="/travel/">All sponsored travel</a>.
    </p>
  </section>

  {
    m.committees.length > 0 && (
      <section class="story">
        <h2>Every PAC that gave</h2>
        <p class="chart-dek">The {m.committees.length.toLocaleString()} committees that contributed to {last}, largest first.</p>
        <RankedTable
          heading="PAC"
          valueHeading="Given"
          rows={m.committees.slice(0, 10).map((c) => {
            const committee = committeeById.get(c.id);
            return { label: committeeLabel(c.id), value: c.total, href: committeeHref(c.id), note: committee ? kindLabel(committee.kind) : undefined };
          })}
        />
        {m.committees.length > 10 && (
          <MoreDisclosure client:visible title={`All ${m.committees.length.toLocaleString()} PACs`}>
            <table>
              <tbody>
                {m.committees.map((c) => (
                  <tr>
                    <td><a href={committeeHref(c.id)}>{committeeLabel(c.id)}</a></td>
                    <td class="num">{moneyAuto(c.total)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </MoreDisclosure>
        )}
      </section>
    )
  }
</Base>

<style>
  .investments-link { margin: calc(-1 * var(--sp-4)) 0 var(--sp-6); font-size: var(--fs-sm); font-weight: 600; }
  .member-head { display: flex; gap: var(--sp-5); align-items: flex-end; margin-bottom: var(--sp-4); }
  .member-head img, .portrait-empty {
    flex: none; width: 104px; height: 128px; border-radius: 2px; object-fit: cover; background: var(--surface-2);
    margin-bottom: var(--sp-4);
  }
  .portrait-empty {
    display: grid; place-items: center; font: 700 2rem/1 var(--serif); color: var(--text-muted);
    border: 1px solid var(--hairline);
  }
  .member-head h1 { margin-bottom: var(--sp-4); }
  .meta { display: flex; flex-wrap: wrap; gap: var(--sp-5) var(--sp-7); margin: calc(-1 * var(--sp-4)) 0 var(--sp-7); }
  .meta .kicker { margin-bottom: var(--sp-2); }
  .part { font: 700 var(--fs-lg)/1.25 var(--serif); margin: var(--sp-6) 0 var(--sp-2); }
  .who { margin: var(--sp-5) 0 var(--sp-2); }
  @media (max-width: 640px) {
    .member-head { gap: var(--sp-4); }
    .member-head img, .portrait-empty { width: 72px; height: 88px; margin-bottom: var(--sp-3); }
  }
  .spaced { margin-top: var(--sp-6); }
</style>
