---
// /races/ is the latest election's list.
import { latestYear } from "../../lib/races";
const to = `/races/${latestYear}/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{latestYear} races</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(to, Astro.site).href} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body><p><a href={to}>The {latestYear} House and Senate races</a></p></body>
</html>
