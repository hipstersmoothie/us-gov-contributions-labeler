---
// /races/ is the current election's list.
const to = "/races/2026/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>2026 races</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(to, Astro.site).href} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body><p><a href={to}>The 2026 House and Senate races</a></p></body>
</html>
