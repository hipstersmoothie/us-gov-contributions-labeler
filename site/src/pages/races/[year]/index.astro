---
import Base from "../../../layouts/Base.astro";
import RacesTable from "../../../islands/RacesTable";
import { money } from "../../../lib/data";
import { racesOf, raceYears, raceName, raceShort, raceHref, personName, partyLetterOf, raised, tierOf, resultLine, noResult, redrawnStates, electionOf, fileByYear, day, PENDING } from "../../../lib/races";
import { listOf, abs } from "../../../lib/seo";
import type { RaceRow } from "../../../islands/types";

export function getStaticPaths() {
  return raceYears.map((year) => ({ params: { year: String(year) }, props: { year } }));
}
const { year: raceYear } = Astro.props as { year: number };
const races = racesOf(raceYear);
const E = electionOf(raceYear);
const today = new Date().toISOString().slice(0, 10);
const before = today < E.electionDay;
const ballotSource = fileByYear.get(raceYear)?.fec?.ballot
  ? "the FEC's list of general-election candidates, compiled from state election offices"
  : "the pre- and post-general reports their campaigns filed";
const REDRAWN_STATES = redrawnStates(raceYear);

const rows: RaceRow[] = races.map((r) => ({
  id: r.id,
  name: raceName(r),
  short: raceShort(r),
  href: raceHref(r),
  state: r.state,
  chamber: r.office === "S" ? "senate" : "house",
  open: r.open,
  field: r.candidates.slice(0, 4).map((c) => {
    const p = partyLetterOf(c);
    return { party: p ?? c.party ?? "", name: personName(c).replace(/,? (Jr\.|Sr\.|II|III|IV)$/, "").split(" ").at(-1)! };
  }),
  names: r.candidates.map(personName).join(" "),
  raised: r.candidates.reduce((s, c) => s + raised(c), 0),
  outside: r.outside.general,
  tier: tierOf(r),
  redrawn: !!r.redrawn,
  result: r.result.status === "pending" ? "Pending certification" : r.result.status === "upcoming" ? "Upcoming" : resultLine(r),
}));
const states = [...new Set(races.map((r) => r.state))].sort();
const totalRaised = rows.reduce((s, r) => s + r.raised, 0);
const outsideAll = races.reduce((s, r) => s + r.outside.total, 0);
const open = races.filter((r) => r.open).length;
const candidates = races.reduce((s, r) => s + r.candidates.length, 0);
const senate = races.filter((r) => r.office === "S").length;
const decided = races.filter((r) => !noResult(r) && r.result.status !== "runoff").length;
const runoffs = races.filter((r) => r.result.status === "runoff").length;
const description = `All ${races.length} House and Senate races of ${raceYear}: the ${candidates.toLocaleString()} candidates on the November ballot, what each raised and who spent from outside. Filter by state, chamber, open seats and outside spending.`;
---

<Base
  title={`${raceYear} House and Senate races`}
  {description}
  og={{ type: "page", id: `races-${raceYear}` }}
  crumbs={[[`${raceYear} races`, `/races/${raceYear}/`]]}
  jsonLd={{ "@context": "https://schema.org", "@type": "CollectionPage", url: abs(`/races/${raceYear}/`), name: `${raceYear} House and Senate races`, description }}
>
  <p class="kicker">{raceYear} races</p>
  <h1>The {raceYear} House and Senate races</h1>
  <p class="dek">
    Every race on the {day(E.electionDay)} ballot: {races.length - senate} for the House and {senate} for the Senate,
    with the {candidates.toLocaleString()} candidates on the ballot by {ballotSource}. They raised{" "}
    <strong>{money(totalRaised, true)}</strong>, and outside groups spent <strong>{money(outsideAll, true)}</strong> on
    the races, primaries included.
  </p>
  <div class="result" role="note">
    {before ? (
      <><strong>Election day is {day(E.electionDay)}.</strong> Until then, each race lists the candidates who raised money.</>
    ) : (
      <>
        <strong>
          {decided === races.length ? "Every race has an official result." : decided ? `${decided} of ${races.length} races have an official result; the rest are pending certification.` : `${PENDING}.`}
        </strong>{" "}
        We show a winner only once a state certifies its result, the FEC publishes official results, or the winner is
        sworn in on {day(E.newCongress)}, and we don't call races.
        {runoffs > 0 && <> {runoffs === 1 ? "One race goes" : `${runoffs} races go`} to a runoff.</>}
        {Object.entries(E.systemNotes ?? {}).map(([, note]) => <> {note}</>)}
      </>
    )}
  </div>

  <dl class="stats">
    <div class="stat"><dt>Races</dt><dd>{races.length}</dd></div>
    <div class="stat"><dt>Candidates on the ballot</dt><dd>{candidates.toLocaleString()}</dd></div>
    <div class="stat"><dt>Open seats</dt><dd>{open}</dd></div>
    <div class="stat"><dt>Outside spending</dt><dd>{money(outsideAll, true)}</dd></div>
  </dl>

  <p class="note-line">
    <strong>New maps.</strong> {listOf(REDRAWN_STATES)} drew new congressional districts for {raceYear}; House races there
    are keyed by the new district numbers, and each says so.
  </p>

  <RacesTable client:idle rows={rows} states={states} />

  <p class="source">
    Candidates from the FEC candidate master, on the ballot by {ballotSource}; money from FEC campaign summaries; outside spending from independent expenditure reports and 24- and 48-hour notices.
    "Outside, general" counts spending coded to the general election. <a href="/about/#races">How races are built</a>
  </p>
</Base>

<style>
  .result {
    margin: 0 0 var(--sp-5); padding: var(--sp-3) var(--sp-4); border-left: 3px solid var(--rule);
    background: var(--surface-2); font-size: var(--fs-sm); max-width: 72ch;
  }
  .note-line { font-size: var(--fs-sm); color: var(--text-secondary); max-width: 72ch; }
</style>
