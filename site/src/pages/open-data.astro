---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import { generatedAt } from "../lib/data";
import examples from "../data/open-data-examples.json";

const DID = "did:plc:ej5cllsvxdrzdsweyfgr2nge";
const XRPC = "https://pds.contributions.fyi/xrpc";

// Highlighted at build time with Shiki; colors follow the site's light/dark mode.
const themes = { light: "github-light", dark: "github-dark" } as const;
const json = (value: unknown) => JSON.stringify(value, null, 2);

// curl -G turns each -d into a query parameter, which reads better than one long URL.
const request = (method: string, params: Record<string, string>, comment: string) =>
  `# ${comment}\ncurl -sG ${XRPC}/${method} \\\n` +
  Object.entries({ repo: DID, ...params })
    .map(([k, v]) => `  -d ${k}=${v}`)
    .join(" \\\n");

const account = request(
  "com.atproto.repo.getRecord",
  { collection: "fyi.contributions.account", rkey: "did:plc:sp4ywsk4ykfkw2cshoqo3s7p" },
  "Nancy Pelosi's account (@pelosi.house.gov), by its DID"
);
const dataset = request(
  "com.atproto.repo.getRecord",
  { collection: "fyi.contributions.dataset", rkey: "self" },
  "the dataset record and its file list"
);

const files = `DID=${DID}
curl -s "${XRPC}/com.atproto.repo.getRecord?repo=$DID&collection=fyi.contributions.dataset&rkey=self" |
  jq -r '.value.files[] | "\\(.name) \\(.blob.ref["$link"])"' |
  while read -r name cid; do
    curl -s "${XRPC}/com.atproto.sync.getBlob?did=$DID&cid=$cid" | gunzip > "\${name%.gz}"
  done`;

const goat = `goat get at://data.contributions.fyi/fyi.contributions.member/C000127
goat record ls data.contributions.fyi --collection fyi.contributions.member
goat repo export data.contributions.fyi -o contributions.car
goat repo unpack contributions.car -o contributions   # one JSON file per record`;

const member = request(
  "com.atproto.repo.getRecord",
  { collection: "fyi.contributions.member", rkey: "C000127" },
  "one record: Maria Cantwell, by bioguide id"
);
const list = request(
  "com.atproto.repo.listRecords",
  { collection: "fyi.contributions.committee", limit: "100" },
  "a page of a collection; add -d cursor=… with the returned cursor for the next page"
);

const collections = [
  ["fyi.contributions.dataset", "self", "Generation time, election cycles, sources, methodology, license, and the complete data files as gzipped JSON blobs"],
  ["fyi.contributions.account", "Bluesky DID", "Who funds this account: a member's totals, top sectors and top contributors, linking to their member record"],
  ["fyi.contributions.member", "bioguide id, e.g. C000127", "Members of Congress: campaign totals, sectors, top contributors, outside spending, committee seats, individual donations"],
  ["fyi.contributions.committee", "FEC committee id, e.g. C00030718", "PACs and other FEC committees: who they gave to, outside spending, big donors"],
  ["fyi.contributions.organization", "slug, e.g. lockheed-martin", "The companies, unions and groups behind PACs: sector, SEC and lobbying records, recipients"],
  ["fyi.contributions.donor", "slug, e.g. elon-musk-tx", "Donors of $50,000 or more to super PACs and other outside spenders"],
  ["fyi.contributions.congressCommittee", "Thomas id, e.g. HSAG", "Committees of Congress and their members"],
];
---

<Base title="Open data" og={{ type: "page", id: "open-data" }} description="Download the whole dataset with standard atproto tools.">
  <p class="kicker">Open data</p>
  <h1>Take the data with you</h1>
  <p class="dek">
    Everything on this site is published as open data in the <a href="https://atproto.com">AT Protocol</a>{" "}
    repository <a href="https://bsky.app/profile/data.contributions.fyi">@data.contributions.fyi</a>, on our own
    server. There's no API key to request and no terms to agree to.
  </p>

  <article class="prose">
    <h2>Where it lives</h2>
    <p>
      The repository's DID is <code>{DID}</code>, hosted at <code>pds.contributions.fyi</code>. Download it with
      any atproto tool, or with plain HTTP as below.
    </p>

    <h2>Who funds this account?</h2>
    <p>
      Every member of Congress's Bluesky account has a record keyed by the account's DID, so any app can look one up
      with a single request. It answers with their totals, top sectors and top contributors, and a link to the full
      member record. Accounts that aren't a member's get <code>RecordNotFound</code>.
    </p>
    <Code code={account} lang="sh" themes={themes} defaultColor={false} />
    <details open>
      <summary>Example response</summary>
      <Code code={json(examples.account)} lang="json" themes={themes} defaultColor={false} />
    </details>

    <h2>Everything at once</h2>
    <p>
      The <code>fyi.contributions.dataset</code> record links the complete data files as gzipped JSON, the same
      files this site is built from. This downloads all of them (needs <code>curl</code> and <code>jq</code>):
    </p>
    <Code code={files} lang="sh" themes={themes} defaultColor={false} />
    <Code code={dataset} lang="sh" themes={themes} defaultColor={false} />
    <details>
      <summary>Example response</summary>
      <Code code={json(examples.dataset)} lang="json" themes={themes} defaultColor={false} />
    </details>

    <h2>With goat</h2>
    <p>
      <a href="https://github.com/bluesky-social/goat">goat</a> fetches single records, lists them, or exports the
      whole repository as a CAR file:
    </p>
    <Code code={goat} lang="sh" themes={themes} defaultColor={false} />

    <h2>Over HTTP</h2>
    <p>
      Each entity is also its own record, readable with the standard XRPC endpoints. Records link to each other by
      at-uri, in <code>uri</code> fields next to the ids (a member to their contributors' organizations, PACs and
      outside spenders; a PAC to its organization, sponsor and recipients; a donor to the PACs it gave to), so a tool
      can walk from any record to the rest. <code>listRecords</code> pages through a collection, 100 at a time:
    </p>
    <Code code={member} lang="sh" themes={themes} defaultColor={false} />
    <details>
      <summary>Example response</summary>
      <Code code={json(examples.member)} lang="json" themes={themes} defaultColor={false} />
    </details>
    <Code code={list} lang="sh" themes={themes} defaultColor={false} />
    <details>
      <summary>Example response</summary>
      <Code code={json(examples.list)} lang="json" themes={themes} defaultColor={false} />
    </details>
    <p class="note">
      Example responses are real records, fetched {new Date(examples.fetchedAt).toLocaleDateString("en-US", { dateStyle: "long" })},
      with long lists cut to their first few entries.
    </p>

    <h2>Collections</h2>
    <table>
      <thead><tr><th>NSID</th><th>Record key</th><th>Contents</th></tr></thead>
      <tbody>
        {collections.map(([nsid, key, what]) => <tr><td><code>fyi.contributions.<wbr />{nsid!.replace("fyi.contributions.", "")}</code></td><td>{key}</td><td>{what}</td></tr>)}
      </tbody>
    </table>
    <p>
      The lexicons are in the <a href="https://github.com/hipstersmoothie/us-gov-contributions-labeler/tree/main/lexicons">project's source</a>{" "}
      and published as <code>com.atproto.lexicon.schema</code> records in the same repository. In records, amounts
      are whole US dollars, because the atproto data model has no fractions; the files keep exact cents.
    </p>

    <h2>License</h2>
    <p>
      The FEC, SEC and lobbying disclosure records this is built from are US government works in the public domain.
      Our additions (sector and industry classifications, organization matching, Bluesky account matching and the
      compiled totals) are dedicated to the public domain under{" "}
      <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0</a>. Use them for anything. Credit to
      contributions.fyi is appreciated but not required. See <a href="/about/">About</a> for how the data is
      classified, and check FEC filings before relying on any single number.
    </p>

    <p class="source">Data last updated {generatedAt.toLocaleDateString("en-US", { dateStyle: "long" })}.</p>
  </article>
</Base>

<style>
  .prose { max-width: 760px; font-size: var(--fs-md); line-height: 1.65; }
  .prose h2 { margin-top: var(--sp-7); padding-top: var(--sp-4); border-top: 1px solid var(--rule); }
  .prose h2:first-child { margin-top: 0; }
  .prose p { margin: 0 0 var(--sp-4); }
  code { font: 0.875em/1.5 ui-monospace, "SF Mono", Menlo, monospace; }
  p code { padding: 1px 4px; border-radius: 2px; background: var(--surface-2); overflow-wrap: anywhere; }
  .prose :global(pre.astro-code) {
    overflow-x: auto; margin: 0 0 var(--sp-4); padding: var(--sp-4); border-left: 3px solid var(--baseline);
    background-color: var(--surface-2) !important; font-size: var(--fs-sm); line-height: 1.5;
  }
  .prose :global(pre.astro-code code) { font: inherit; font-family: ui-monospace, "SF Mono", Menlo, monospace; }
  /* Shiki writes both themes' colors as variables; pick one per color scheme. */
  .prose :global(.astro-code span) { color: var(--shiki-light); }
  @media (prefers-color-scheme: dark) {
    .prose :global(.astro-code span) { color: var(--shiki-dark); }
  }
  details { margin: calc(-1 * var(--sp-2)) 0 var(--sp-5); }
  details summary { cursor: pointer; font-size: var(--fs-sm); color: var(--text-secondary); margin-bottom: var(--sp-2); }
  details :global(pre.astro-code) { max-height: 28rem; }
  .note { font-size: var(--fs-sm); color: var(--text-muted); }
  table { font-size: var(--fs-sm); }
  /* Keep NSIDs whole; on phones they may wrap after "fyi.contributions.". */
  td code { white-space: nowrap; }
  td code wbr { display: none; } /* Chrome breaks at <wbr> even with nowrap */
  @media (max-width: 640px) {
    td code { white-space: normal; }
    td code wbr { display: inline; }
  }
</style>
