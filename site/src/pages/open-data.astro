---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import { cycles, generatedAt } from "../lib/data";
import { abs, SITE_NAME } from "../lib/seo";
import examples from "../data/open-data-examples.json";

const DID = "did:plc:ej5cllsvxdrzdsweyfgr2nge";
const XRPC = "https://pds.contributions.fyi/xrpc";

// Highlighted at build time with Shiki; colors follow the site's light/dark mode.
const themes = { light: "github-light", dark: "github-dark" } as const;
const json = (value: unknown) => JSON.stringify(value, null, 2);

// curl -G turns each -d into a query parameter, which reads better than one long URL.
const request = (method: string, params: Record<string, string>, comment: string) =>
  `# ${comment}\ncurl -sG ${XRPC}/${method} \\\n` +
  Object.entries({ repo: DID, ...params })
    .map(([k, v]) => `  -d ${k}=${v}`)
    .join(" \\\n");

const account = request(
  "com.atproto.repo.getRecord",
  { collection: "fyi.contributions.account", rkey: "did:plc:sp4ywsk4ykfkw2cshoqo3s7p" },
  "Nancy Pelosi's account (@pelosi.house.gov), by its DID"
);
const dataset = request(
  "com.atproto.repo.getRecord",
  { collection: "fyi.contributions.dataset", rkey: "self" },
  "the dataset record and its file list"
);

const files = `DID=${DID}
curl -s "${XRPC}/com.atproto.repo.getRecord?repo=$DID&collection=fyi.contributions.dataset&rkey=self" |
  jq -r '.value.files[] | "\\(.name) \\(.blob.ref["$link"])"' |
  while read -r name cid; do
    curl -s "${XRPC}/com.atproto.sync.getBlob?did=$DID&cid=$cid" | gunzip > "\${name%.gz}"
  done`;

// Download one file from the dataset record by name.
const download = (name: string) => `DID=${DID}
CID=$(curl -s "${XRPC}/com.atproto.repo.getRecord?repo=$DID&collection=fyi.contributions.dataset&rkey=self" |
  jq -r '.value.files[] | select(.name == "${name}.gz") | .blob.ref["$link"]')
curl -s "${XRPC}/com.atproto.sync.getBlob?did=$DID&cid=$CID" | gunzip > ${name}`;

const sql = `${download("contributions.sqlite")}

# what's in it: a table per list in the JSON, and what each holds
sqlite3 contributions.sqlite "SELECT name, rows, description FROM tables"

# the members defense PACs gave the most
sqlite3 -header -column contributions.sqlite "
  SELECT member, party, sum(total) AS total
  FROM pac_contributions
  WHERE sector = 'Defense'
  GROUP BY bioguide ORDER BY total DESC LIMIT 10"`;

const fecSql = `${download("fec-lines.sqlite")}

# Maria Cantwell's PAC contributions this cycle, newest first, with the filing each is on
sqlite3 -header -column fec-lines.sqlite "
  SELECT c.date, g.name AS pac, o.sector, c.amount, c.image_url
  FROM fec_contributions_with_links c
  JOIN committees g ON g.id = c.committee
  LEFT JOIN organizations o ON o.id = g.organization
  WHERE c.bioguide = 'C000127' AND c.cycle = 2026
  ORDER BY c.date DESC"`;

const lobbyingSql = `${download("lobbying-filings.sqlite")}

# who Lockheed Martin paid to lobby, by quarter
sqlite3 -header -column lobbying-filings.sqlite "
  SELECT year, period, registrant_name, income, url
  FROM lobbying_filings_with_links
  WHERE organization = 'lockheed-martin' AND type NOT LIKE 'R%'
  ORDER BY posted DESC"`;

const mcp = `# Claude Code
claude mcp add --transport http contributions-fyi ${abs("/mcp")}

# other clients: Streamable HTTP, no sign-in
{ "mcpServers": { "contributions-fyi": { "type": "http", "url": "${abs("/mcp")}" } } }`;

const goat = `goat get at://data.contributions.fyi/fyi.contributions.member/C000127
goat record ls data.contributions.fyi --collection fyi.contributions.member
goat repo export data.contributions.fyi -o contributions.car
goat repo unpack contributions.car -o contributions   # one JSON file per record`;

const member = request(
  "com.atproto.repo.getRecord",
  { collection: "fyi.contributions.member", rkey: "C000127" },
  "one record: Maria Cantwell, by bioguide id"
);
const list = request(
  "com.atproto.repo.listRecords",
  { collection: "fyi.contributions.committee", limit: "100" },
  "a page of a collection; add -d cursor=… with the returned cursor for the next page"
);

// For dataset search (https://developers.google.com/search/docs/appearance/structured-data/dataset).
const datasetLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "contributions.fyi: PAC money to members of Congress",
  description:
    `Campaign contributions from PACs and other political committees to every current member of Congress, ${cycles[0]! - 1} to ${cycles.at(-1)}, ` +
    "from FEC filings: totals by member, organization, sector and industry, outside spending for and against members, " +
    "big donors to super PACs, congressional committee seats, and members' Bluesky accounts. Organizations are matched to " +
    "SEC EDGAR and lobbying disclosure records. Published as an AT Protocol repository with complete gzipped JSON and SQLite files, " +
    "plus the FEC lines and lobbying filings behind the totals as SQLite.",
  url: abs("/open-data/"),
  sameAs: "https://bsky.app/profile/data.contributions.fyi",
  identifier: DID,
  keywords: ["campaign finance", "PAC contributions", "Congress", "FEC", "lobbying", "political action committees", "AT Protocol"],
  license: "https://creativecommons.org/publicdomain/zero/1.0/",
  isAccessibleForFree: true,
  creator: { "@type": "Organization", "@id": abs("/#publisher"), name: SITE_NAME, url: abs("/") },
  temporalCoverage: `${cycles[0]! - 1}/${cycles.at(-1)}`,
  spatialCoverage: { "@type": "Place", name: "United States" },
  dateModified: generatedAt.toISOString(),
  distribution: [
    {
      "@type": "DataDownload",
      name: "The whole repository, as a CAR file",
      encodingFormat: "application/vnd.ipld.car",
      contentUrl: `${XRPC}/com.atproto.sync.getRepo?did=${DID}`,
    },
    {
      "@type": "DataDownload",
      name: "The dataset record, listing the complete gzipped JSON and SQLite files",
      encodingFormat: "application/json",
      contentUrl: `${XRPC}/com.atproto.repo.getRecord?repo=${DID}&collection=fyi.contributions.dataset&rkey=self`,
    },
  ],
};

const collections = [
  ["fyi.contributions.dataset", "self", "Generation time, election cycles, sources, methodology, license, and the complete data files as gzipped JSON and SQLite blobs"],
  ["fyi.contributions.account", "Bluesky DID", "Who funds this account: a member's totals, top sectors and top contributors, linking to their member record"],
  ["fyi.contributions.member", "bioguide id, e.g. C000127", "Members of Congress: campaign totals, sectors, top contributors, outside spending, electioneering, small and in-state donors, lobbyist bundlers, committee seats, former staff who now lobby, and registered foreign agents' donations"],
  ["fyi.contributions.committee", "FEC committee id, e.g. C00030718", "PACs, other FEC committees and non-committee spenders (Form 5 and 9 filers): who they gave to, outside spending, big donors, whether they disclose donors"],
  ["fyi.contributions.organization", "slug, e.g. lockheed-martin", "The companies, unions and groups behind PACs: sector, SEC and lobbying records, recipients, contributions their lobbyists bundled"],
  ["fyi.contributions.donor", "slug, e.g. elon-musk-tx", "Donors who gave a super PAC or other outside spender $50,000 or more in all"],
  ["fyi.contributions.congressCommittee", "Thomas id, e.g. HSAG", "Committees of Congress, their members, and former committee staff who now lobby"],
  ["fyi.contributions.foreignCountry", "slug, e.g. japan", "Foreign principals in each country with US agents registered under FARA, and those agents"],
];
---

<Base
  title="Open data: download the campaign finance dataset"
  og={{ type: "page", id: "open-data" }}
  description="Download every member's PAC money, organizations, sectors, outside spending and big donors as open data (CC0): one AT Protocol repository, with complete JSON and SQLite files and the FEC and lobbying records behind them. No API key."
  crumbs={[["Open data", "/open-data/"]]}
  jsonLd={datasetLd}
>
  <p class="kicker">Open data</p>
  <h1>Take the data with you</h1>
  <p class="dek">
    Everything on this site is published as open data in the <a href="https://atproto.com">AT Protocol</a>{" "}
    repository <a href="https://bsky.app/profile/data.contributions.fyi">@data.contributions.fyi</a>, on our own
    server, as JSON and as SQLite databases you can query, along with the FEC and lobbying records behind it. There's
    no API key to request and no terms to agree to.
  </p>

  <article class="prose">
    <h2>Where it lives</h2>
    <p>
      The repository's DID is <code>{DID}</code>, hosted at <code>pds.contributions.fyi</code>. Download it with
      any atproto tool, or with plain HTTP as below.
    </p>

    <h2>Who funds this account?</h2>
    <p>
      Every member of Congress's Bluesky account has a record keyed by the account's DID, so any app can look one up
      with a single request. It answers with their totals, top sectors and top contributors, and a link to the full
      member record. Accounts that aren't a member's get <code>RecordNotFound</code>.
    </p>
    <Code code={account} lang="sh" themes={themes} defaultColor={false} />
    <details open>
      <summary>Example response</summary>
      <Code code={json(examples.account)} lang="json" themes={themes} defaultColor={false} />
    </details>

    <h2>Everything at once</h2>
    <p>
      The <code>fyi.contributions.dataset</code> record links the complete data files as gzipped JSON, the same
      files this site is built from, including <code>revolving-door.json</code> (lobbyists' former government jobs)
      and <code>fara.json</code> (foreign agents and their principals), and the SQLite files below. This downloads all
      of them, about 100 MB compressed, most of it the source records (needs <code>curl</code> and <code>jq</code>):
    </p>
    <Code code={files} lang="sh" themes={themes} defaultColor={false} />
    <Code code={dataset} lang="sh" themes={themes} defaultColor={false} />
    <details>
      <summary>Example response</summary>
      <Code code={json(examples.dataset)} lang="json" themes={themes} defaultColor={false} />
    </details>

    <h2>Query it with SQL</h2>
    <p>
      <code>contributions.sqlite</code> holds everything in the JSON files as tables: one for each kind of record
      (<code>members</code>, <code>committees</code>, <code>organizations</code>, <code>bills</code>,{" "}
      <code>travel_trips</code> and so on) and one for each list inside them, like <code>committees_recipients</code>{" "}
      (who each PAC gave to) or <code>bills_votes_yes</code>. List tables link back by the record's id, in a column
      named for it (<code>committee_id</code>, <code>member_bioguide</code>). The <code>tables</code> table describes
      them all, and the views <code>pac_contributions</code>, <code>outside_spending</code> and{" "}
      <code>member_votes</code> join the common ones. Query it with <code>sqlite3</code>,{" "}
      <a href="https://datasette.io">Datasette</a>, <a href="https://duckdb.org">DuckDB</a> or any SQLite library:
    </p>
    <Code code={sql} lang="sh" themes={themes} defaultColor={false} />

    <h2>The records behind it</h2>
    <p>
      The totals on this site add up individual filings. Two more SQLite files hold those filings, linked to the same
      member, committee and organization ids:
    </p>
    <table>
      <thead><tr><th>File</th><th>Contents</th></tr></thead>
      <tbody>
        <tr>
          <td><code>fec-lines.sqlite</code></td>
          <td>
            Every FEC line counted toward current members' totals, as filed: PAC contributions to their campaigns
            (<code>fec_contributions</code>), independent expenditures for or against them or their opponents
            (<code>fec_independent_expenditures</code>, from processed reports, 24/48-hour notices and Form 5), and
            electioneering communications (<code>fec_electioneering</code>). Refunds and corrections are negative, so
            the lines sum to the totals here.
          </td>
        </tr>
        <tr>
          <td><code>lobbying-filings.sqlite</code></td>
          <td>
            Every lobbying registration and quarterly report (LD-1, LD-2) filed for the current Congress, amendments
            included: client, firm, income or expenses, issues and descriptions (<code>lobbying_filings_activities</code>),
            and the lobbyists with the government jobs they disclosed (<code>lobbying_filings_lobbyists</code>).
          </td>
        </tr>
      </tbody>
    </table>
    <Code code={fecSql} lang="sh" themes={themes} defaultColor={false} />
    <Code code={lobbyingSql} lang="sh" themes={themes} defaultColor={false} />
    <p>
      Individual donors aren't listed by name. Like this site, the files count their donations by employer, sector
      and place, except for donations of $50,000 or more to outside spenders (<code>donors</code>). The FEC publishes
      every itemized donation in its <a href="https://www.fec.gov/data/browse-data/?tab=bulk-data">bulk data</a>, and
      federal law bars using the names in it to ask for money or for commercial purposes.
    </p>

    <h2 id="mcp">Ask an AI assistant</h2>
    <p>
      This site runs an <a href="https://modelcontextprotocol.io">MCP</a> server at <code>{abs("/mcp")}</code>, so
      assistants like Claude can look things up here and link to the pages behind their answers. <code>search</code>{" "}
      finds anything by name, as the search box does; <code>get_record</code> reads a page's full record;{" "}
      <code>find_members</code> says who represents a ZIP code or street address; and <code>list_tables</code> and{" "}
      <code>query</code> run SQL over everything above, <code>contributions.sqlite</code> and both filing files, plus
      races and the districts of each ZIP code. It also has House members' investments, from their financial
      disclosures, with the notice that comes with them: those aren't part of the open data, and 5 U.S.C. § 13107
      limits how they can be used, so reading them in bulk asks you to agree to those limits first. Add it as a custom connector in your assistant's settings, or:
    </p>
    <Code code={mcp} lang="sh" themes={themes} defaultColor={false} />

    <h2>With goat</h2>
    <p>
      <a href="https://github.com/bluesky-social/goat">goat</a> fetches single records, lists them, or exports the
      whole repository as a CAR file:
    </p>
    <Code code={goat} lang="sh" themes={themes} defaultColor={false} />

    <h2>Over HTTP</h2>
    <p>
      Each entity is also its own record, readable with the standard XRPC endpoints. Records link to each other by
      at-uri, in <code>uri</code> fields next to the ids (a member to their contributors' organizations, PACs and
      outside spenders; a PAC to its organization, sponsor and recipients; a donor to the PACs it gave to), so a tool
      can walk from any record to the rest. <code>listRecords</code> pages through a collection, 100 at a time:
    </p>
    <Code code={member} lang="sh" themes={themes} defaultColor={false} />
    <details>
      <summary>Example response</summary>
      <Code code={json(examples.member)} lang="json" themes={themes} defaultColor={false} />
    </details>
    <Code code={list} lang="sh" themes={themes} defaultColor={false} />
    <details>
      <summary>Example response</summary>
      <Code code={json(examples.list)} lang="json" themes={themes} defaultColor={false} />
    </details>
    <p class="note">
      Example responses are real records, fetched {new Date(examples.fetchedAt).toLocaleDateString("en-US", { dateStyle: "long" })},
      with long lists cut to their first few entries.
    </p>

    <h2>Collections</h2>
    <table>
      <thead><tr><th>NSID</th><th>Record key</th><th>Contents</th></tr></thead>
      <tbody>
        {collections.map(([nsid, key, what]) => <tr><td><code>fyi.contributions.<wbr />{nsid!.replace("fyi.contributions.", "")}</code></td><td>{key}</td><td>{what}</td></tr>)}
      </tbody>
    </table>
    <p>
      The lexicons are in the <a href="https://github.com/hipstersmoothie/us-gov-contributions-labeler/tree/main/lexicons">project's source</a>{" "}
      and published as <code>com.atproto.lexicon.schema</code> records in the same repository. In records, amounts
      are whole US dollars, because the atproto data model has no fractions; the files keep exact cents.
    </p>

    <h2>License</h2>
    <p>
      The FEC, SEC, lobbying disclosure and FARA records this is built from are US government works in the public
      domain. Our additions (sector and industry classifications, organization matching, Bluesky account matching,
      lobbyists' job matching and the compiled totals) are dedicated to the public domain under{" "}
      <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0</a>. Use them for anything. Credit to
      contributions.fyi is appreciated but not required. See <a href="/about/">About</a> for how the data is
      classified, and check FEC filings before relying on any single number.
    </p>

    <p class="source">Data last updated {generatedAt.toLocaleDateString("en-US", { dateStyle: "long" })}.</p>
  </article>
</Base>

<script>
  // Copy buttons on the code samples. Copies are counted by section, whether by
  // button or by selecting the text; copying a snippet that downloads the
  // dataset counts as a download.
  import { track } from "../lib/analytics";

  const sectionOf = new Map<Element, string>();
  let heading = "";
  for (const el of document.querySelectorAll(".prose h2, .prose pre.astro-code")) {
    if (el.tagName === "H2") heading = el.textContent ?? "";
    else sectionOf.set(el, heading);
  }
  const report = (pre: Element, how: string) => {
    const download = /getBlob|getRepo|repo export/.test(pre.textContent ?? "");
    track(download ? "Open data: download" : "Open data: copy", {
      section: sectionOf.get(pre) ?? "",
      sample: pre.closest("details") ? "example response" : "command",
      how,
    });
  };

  for (const pre of sectionOf.keys()) {
    const wrap = document.createElement("div");
    wrap.className = "snippet";
    pre.replaceWith(wrap);
    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-button";
    button.textContent = "Copy";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? "");
      } catch {
        // No clipboard access: select the code so it can be copied by hand.
        getSelection()?.selectAllChildren(pre);
        return;
      }
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy"), 1500);
      report(pre, "button");
    });
    wrap.append(pre, button);
  }

  document.addEventListener("copy", () => {
    const node = document.getSelection()?.anchorNode;
    const pre = (node instanceof Element ? node : node?.parentElement)?.closest("pre.astro-code");
    if (pre) report(pre, "selection");
  });
</script>

<style>
  .prose { max-width: 760px; font-size: var(--fs-md); line-height: 1.65; }
  .prose h2 { margin-top: var(--sp-7); padding-top: var(--sp-4); border-top: 1px solid var(--rule); }
  .prose h2:first-child { margin-top: 0; }
  .prose p { margin: 0 0 var(--sp-4); }
  code { font: 0.875em/1.5 ui-monospace, "SF Mono", Menlo, monospace; }
  p code { padding: 1px 4px; border-radius: 2px; background: var(--surface-2); overflow-wrap: anywhere; }
  .prose :global(pre.astro-code) {
    overflow-x: auto; margin: 0 0 var(--sp-4); padding: var(--sp-4); border-left: 3px solid var(--baseline);
    background-color: var(--surface-2) !important; font-size: var(--fs-sm); line-height: 1.5;
  }
  .prose :global(pre.astro-code code) { font: inherit; font-family: ui-monospace, "SF Mono", Menlo, monospace; }
  /* Shiki writes both themes' colors as variables; pick one per color scheme. */
  .prose :global(.astro-code span) { color: var(--shiki-light); }
  @media (prefers-color-scheme: dark) {
    .prose :global(.astro-code span) { color: var(--shiki-dark); }
  }
  .prose :global(.snippet) { position: relative; }
  .prose :global(.copy-button) {
    position: absolute; top: var(--sp-2); right: var(--sp-2); padding: 3px 9px; border: 1px solid var(--hairline);
    border-radius: 3px; background: var(--surface); color: var(--text-secondary); cursor: pointer;
    font: 600 var(--fs-label)/1.4 var(--sans); letter-spacing: 0.02em;
  }
  @media (hover: hover) and (pointer: fine) { .prose :global(.copy-button:hover) { color: var(--text-primary); border-color: var(--text-muted); } }
  details { margin: calc(-1 * var(--sp-2)) 0 var(--sp-5); }
  details summary { cursor: pointer; font-size: var(--fs-sm); color: var(--text-secondary); margin-bottom: var(--sp-2); }
  details :global(pre.astro-code) { max-height: 28rem; }
  .note { font-size: var(--fs-sm); color: var(--text-muted); }
  table { font-size: var(--fs-sm); }
  /* Keep NSIDs whole; on phones they may wrap after "fyi.contributions.". */
  td code { white-space: nowrap; }
  td code wbr { display: none; } /* Chrome breaks at <wbr> even with nowrap */
  @media (max-width: 640px) {
    td code { white-space: normal; }
    td code wbr { display: inline; }
  }
</style>
