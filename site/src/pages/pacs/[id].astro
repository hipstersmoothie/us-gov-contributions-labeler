---
import Base from "../../layouts/Base.astro";
import RankedTable from "../../components/RankedTable.astro";
import PartySplit from "../../components/PartySplit.astro";
import Chambers from "../../components/Chambers.astro";
import OutsideTable from "../../components/OutsideTable.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import {
  committees,
  organizationById,
  memberById,
  donorById,
  MIN_DONATION,
  money,
  partySplit,
  partyLetter,
  cycleRange,
  displayName,
  kindLabel,
  orgTypeLabel,
  fecCommitteeUrl,
  fecCandidateUrl,
  hidesDonors,
  type Committee,
} from "../../lib/data";
import { chamberName, cycleLabel, pct } from "../../lib/derived";
import { pacSpending, latestCycle, bucketRows, bucketPhrase, vendorHref, dateLabel, VENDORS_SHOWN, MEMO_NOTE } from "../../lib/disbursements";
import { clip, listOf, organization } from "../../lib/seo";

export function getStaticPaths() {
  // Committees that share a name get their FEC id in the page title.
  const named = new Map<string, number>();
  for (const c of committees) named.set(displayName(c.name), (named.get(displayName(c.name)) ?? 0) + 1);
  return committees.map((c) => ({ params: { id: c.id }, props: { c, shared: named.get(displayName(c.name))! > 1 } }));
}

const { c, shared } = Astro.props as { c: Committee; shared: boolean };
const org = organizationById.get(c.organization);
const split = partySplit(c.recipients);
const name = displayName(c.name);
// A PAC that is its own organization doesn't need a link back to itself.
const showOrg = org && org.committees.length > 1 || (org && c.kind === "pac" && org.name !== name);
const nonCommittee = c.kind === "non-committee";
const ecOnly = c.id.startsWith("C3");

const path = `/pacs/${c.id}/`;
// Leadership PACs: contributions to other committees against their own operating costs, newest cycle on file.
const lp = c.kind === "leadership-pac" ? pacSpending(c.id) : undefined;
const lpCycle = lp && latestCycle(Object.fromEntries(Object.entries(lp.byCycle).map(([k, v]) => [k, { total: Math.max(v.disbursements, v.total) }])));
const ls = lpCycle ? lp!.byCycle[lpCycle] : undefined;
const lpRows = ls ? bucketRows(ls.buckets, 6) : [];
const lpOther = ls ? Math.max(ls.disbursements - ls.contributions - ls.total - ls.independent, 0) : 0;
const lpSegments = ls
  ? [
      { label: "contributions to other committees", value: ls.contributions, color: "var(--bar)", ink: "var(--on-bar)" },
      { label: "its own operating costs", value: ls.total, color: "var(--bar-muted)", ink: "var(--on-bar-muted)" },
      ...(ls.independent > 0 ? [{ label: "independent expenditures", value: ls.independent, color: "var(--context)", ink: "var(--on-context)" }] : []),
      ...(lpOther > 0 ? [{ label: "unitemized spending, refunds and transfers", value: lpOther, color: "var(--surface-2)", ink: "var(--text-primary)" }] : []),
    ].filter((s) => s.value > 0)
  : [];
const span = cycleRange.replace("–", " to ");
const topRecipient = memberById.get(c.recipients[0]?.id ?? "");
const spent = [
  c.outside?.support && `${money(c.outside.support, true)} supporting`,
  c.outside?.oppose && `${money(c.outside.oppose, true)} opposing`,
].filter((x): x is string => !!x);
const spends = nonCommittee || (spent.length > 0 && !(c.total > (c.outside?.support ?? 0) + (c.outside?.oppose ?? 0)));
const title = `${name}${shared ? ` (FEC ${c.id})` : ""}: ${spends ? "outside spending on Congress" : "who it gives to in Congress"}`;
const did = [
  c.total > 0 && `gave ${money(c.total, true)} to ${c.recipients.length} current members of Congress`,
  spent.length && `spent ${listOf(spent)} members`,
].filter((x): x is string => !!x);
const description = clip(
  `${name} is ${c.person ? "a person who reports outside spending" : nonCommittee ? "an outside group, not a PAC" : `a ${kindLabel(c.kind).toLowerCase().replace(/\bpac\b/g, "PAC")}`}` +
    (showOrg ? ` affiliated with ${org!.name}` : "") +
    ` (FEC ${c.id}). ` +
    (did.length
      ? `${c.person ? "They" : "It"} ${listOf(did)} from ${span}.`
      : nonCommittee
        ? `${c.person ? "Their" : "Its"} ${ecOnly ? "electioneering communications" : "independent expenditures"} about members of Congress, ${span}, from FEC filings.`
        : `What it gave to and spent on members of Congress, ${span}, from FEC filings.`) +
    (topRecipient && c.total > 0 ? ` ${topRecipient.name} got the most, ${money(c.recipients[0]!.total, true)}.` : "")
);
---

<Base
  {title}
  og={{ type: "pac", id: c.id }}
  {description}
  crumbs={showOrg ? [["Organizations", "/organizations/"], [org!.name, `/organizations/${org!.id}/`], [name, path]] : [[name, path]]}
  jsonLd={c.person ? undefined : organization({
    path,
    name,
    description,
    sameAs: [fecCommitteeUrl(c.id)],
    parent: showOrg ? { name: org!.name, path: `/organizations/${org!.id}/` } : undefined,
  })}
>
  <p class="kicker">
    {c.person ? "Individual, not a PAC" : kindLabel(c.kind)}{orgTypeLabel(c.orgType) && <> · {orgTypeLabel(c.orgType)}</>} · <a href={fecCommitteeUrl(c.id)}>FEC {c.id}</a>
  </p>
  <h1>{name}</h1>

  {
    nonCommittee && (
      <p class="filer-note">
        {c.person ? (
          <>{name} is a person, not a political committee, and reports independent expenditures to the FEC on Form 5.</>
        ) : (
          <>
            {name} isn't a political committee. It reports its {ecOnly ? "electioneering communications" : "independent expenditures"} to the
            FEC on Form {ecOnly ? "9" : "5"}, as groups other than PACs must.
          </>
        )}{" "}
        {hidesDonors(c) ? (
          <><strong>It doesn't disclose its donors:</strong> its filings for this spending name none.</>
        ) : c.reportedDonations ? (
          <>Its filings list <strong>{money(c.reportedDonations, true)}</strong> received to pay for this spending, {cycleRange}.</>
        ) : null}{" "}
        <a href={fecCommitteeUrl(c.id)}>Its FEC filings</a>.
      </p>
    )
  }

  {
    showOrg && (
      <p>Affiliated with <a href={`/organizations/${org.id}/`}>{org.name}</a> ({org.sector}).</p>
    )
  }
  {
    c.sponsors && (
      <p>
        Leadership PAC of{" "}
        {c.sponsors.map((s, i) => {
          const m = s.bioguide && memberById.get(s.bioguide);
          return (
            <>
              {i > 0 && ", "}
              {m ? <a href={`/members/${m.bioguide}/`}>{m.name}</a> : <a href={fecCandidateUrl(s.fecId)}>{s.fecId}</a>}
            </>
          );
        })}
        .
      </p>
    )
  }

  <dl class="stats">
    {c.total > 0 && <div class="stat"><dt>Given to current members, {cycleRange}</dt><dd>{money(c.total, true)}</dd></div>}
    {c.total > 0 && <div class="stat"><dt>Members funded</dt><dd>{c.recipients.length}</dd></div>}
    {c.outside && c.outside.support > 0 && <div class="stat"><dt>Spent supporting members</dt><dd>{money(c.outside.support, true)}</dd></div>}
    {c.outside && c.outside.oppose > 0 && <div class="stat"><dt>Spent opposing members</dt><dd>{money(c.outside.oppose, true)}</dd></div>}
    {c.opponents && c.opponents.support > 0 && <div class="stat"><dt>Spent supporting members' opponents</dt><dd>{money(c.opponents.support, true)}</dd></div>}
    {c.opponents && c.opponents.oppose > 0 && <div class="stat"><dt>Spent opposing members' opponents</dt><dd>{money(c.opponents.oppose, true)}</dd></div>}
    {c.electioneering && <div class="stat"><dt>On ads naming members, without a for or against</dt><dd>{money(c.electioneering.total, true)}</dd></div>}
  </dl>

  {
    ls && lpCycle && ls.disbursements > 0 && (
      <section class="story" id="spending">
        <h2>Where its money goes</h2>
        <p class="chart-dek">
          In the {cycleLabel(lpCycle)} cycle {name} spent <strong>{money(ls.disbursements, true)}</strong>
          {ls.coverage && <> through {dateLabel(ls.coverage)}</>}: <strong>{pct(ls.contributions, ls.disbursements)}%</strong> as contributions
          to other committees and <strong>{pct(ls.total, ls.disbursements)}%</strong> on its own itemized operating costs
          {ls.independent > 0 && <>, with {money(ls.independent, true)} in independent expenditures</>}.
          {lpRows[0] && ls.total > 0 && <> Of the operating costs, {bucketPhrase(lpRows[0].key)} took {pct(lpRows[0].value, ls.total)}%.</>}{" "}
          A leadership PAC exists to give to other candidates; fundraising, consultants and travel are what it spends getting there.
        </p>
        {lpSegments.length > 0 && (
          <PlotFigure
            chart="makeup"
            width={640}
            label={`${name}: everything it spent, ${cycleLabel(lpCycle)}`}
            data={{ rows: [{ label: "Everything it spent", segments: lpSegments }] }}
            table={{ columns: ["Part", "Amount"], numeric: [1], rows: lpSegments.map((s) => [s.label, money(s.value)]) }}
          />
        )}
        {ls.total > 0 && (
          <div class="grid-2">
            <div>
              <h3>Operating costs by purpose</h3>
              <PlotFigure
                chart="bars"
                width={500}
                label={`${name}'s operating costs by purpose, ${cycleLabel(lpCycle)}`}
                data={{ rows: lpRows.map((r) => ({ label: r.short, value: r.value })), emphasize: [0], total: ls.total }}
                table={{ columns: ["Purpose", "Amount"], numeric: [1], rows: lpRows.map((r) => [r.label, money(r.value)]) }}
              />
            </div>
            <div>
              <h3>Biggest payees</h3>
              <RankedTable
                heading="Payee"
                valueHeading="Paid"
                rank={false}
                caption={`${name}'s biggest payees, ${cycleLabel(lpCycle)}`}
                rows={ls.vendors.slice(0, VENDORS_SHOWN).map((v) => ({
                  label: v.name,
                  href: v.vendor ? vendorHref(v.vendor) : undefined,
                  note: [v.purpose, v.itemized ? "paid by card or payroll service, itemized" : undefined].filter(Boolean).join(" · "),
                  value: v.amount,
                }))}
              />
            </div>
          </div>
        )}
        <p class="source">
          Totals from the FEC's PAC summary file; payees from its operating expenditures file (Form 3X, line 21B)
          {ls.through && <>, processed through {dateLabel(ls.through)}</>}. {MEMO_NOTE}{" "}
          <a href="/vendors/">All campaign vendors</a> · <a href="/about/#spending">How spending is counted</a>.
        </p>
      </section>
    )
  }

  {
    c.opponents && (
      <section class="story">
        <h2>Spending on members' opponents</h2>
        <p class="chart-dek">
          Money this group spent on candidates running against current members, {cycleRange}: other candidates in the
          member's party primary, or in a general election the member was on the ballot for. It spent{" "}
          <strong>{money(c.opponents.support, true)}</strong> supporting those opponents and{" "}
          <strong>{money(c.opponents.oppose, true)}</strong> opposing them. This is separate from spending that named the
          members themselves.
        </p>
        <OutsideTable
          heading="Member whose opponent it was"
          supportHeading="Supporting their opponents"
          opposeHeading="Opposing their opponents"
          rows={c.opponents.targets.slice(0, 30).map((t) => {
            const m = memberById.get(t.id);
            return { label: m?.name ?? t.id, href: `/members/${t.id}/`, party: m ? partyLetter(m.party) : undefined, note: m ? `${chamberName(m)}, ${m.state}` : undefined, support: t.support, oppose: t.oppose };
          })}
        />
      </section>
    )
  }

  {
    (c.outside || c.donors) && (
      <div class="grid-2 section">
        {c.outside && (
          <section class="card">
            <h2>Spending that named current members</h2>
            <OutsideTable
              heading="Member"
              rows={c.outside.targets.slice(0, 30).map((t) => {
                const m = memberById.get(t.id);
                return { label: m?.name ?? t.id, href: `/members/${t.id}/`, party: m ? partyLetter(m.party) : undefined, note: m ? `${chamberName(m)}, ${m.state}` : undefined, support: t.support, oppose: t.oppose };
              })}
            />
          </section>
        )}
        {c.donors && (
          <section class="card">
            <h2>Biggest donors</h2>
            <p class="muted small">Everyone who gave it {money(MIN_DONATION)} or more in all, {cycleRange}.</p>
            <RankedTable
              heading="Donor"
              valueHeading="Given"
              rows={c.donors.slice(0, 30).map((d) => {
                const donor = donorById.get(d.id);
                return {
                  label: donor?.name ?? d.id,
                  value: d.total,
                  href: `/donors/${d.id}/`,
                  note: donor && (donor.type === "individual" ? [donor.occupation, donor.employer].filter(Boolean).join(", ") : donor.type === "committee" ? "Committee" : "Organization"),
                };
              })}
            />
          </section>
        )}
      </div>
    )
  }

  {
    c.electioneering && (
      <section class="story">
        <h2>Electioneering ads naming members</h2>
        <p class="chart-dek">
          Broadcast ads that named a current member shortly before an election, {cycleRange}, without saying to vote for
          or against them. The FEC splits each ad's cost among the candidates it names; these are the members' shares.
        </p>
        <RankedTable
          heading="Member"
          valueHeading="Spent"
          rows={c.electioneering.targets.slice(0, 30).map((t) => {
            const m = memberById.get(t.id);
            return { label: m?.name ?? t.id, value: t.total, href: `/members/${t.id}/`, party: m ? partyLetter(m.party) : undefined, note: m ? `${chamberName(m)}, ${m.state}` : undefined };
          })}
        />
      </section>
    )
  }

  {
    c.recipients.length > 1 && (
      <section class="story">
        <h2>Who it gave to</h2>
        <p class="chart-dek">Every seat in Congress, with the members this committee gave to, {cycleRange}, in their party's color.</p>
        <Chambers recipients={c.recipients} giver={name} />
      </section>
    )
  }

  {c.total > 0 && <div class="grid-2">
    <section class="card">
      <h2>Top recipients</h2>
      <RankedTable
        heading="Member"
        valueHeading="Given"
        rows={c.recipients.slice(0, 25).map((r) => {
          const m = memberById.get(r.id);
          return { label: m?.name ?? r.id, value: r.total, href: `/members/${r.id}/`, party: m ? partyLetter(m.party) : undefined, note: m ? `${chamberName(m)}, ${m.state}` : undefined };
        })}
      />
    </section>
    <section class="card">
      <h2>Split by party</h2>
      <PartySplit split={split} label="Contributions by recipient party" />
    </section>
  </div>}
</Base>

<style>
  .filer-note { max-width: 46rem; }
</style>
