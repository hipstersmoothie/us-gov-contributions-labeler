---
// A committee's former staff who now lobby, past the first few, loaded on request.
import StaffTable from "../../../../components/StaffTable.astro";
import { staffByCommittee, STAFF_SHOWN, type StaffRow } from "../../../../lib/revolving";

export const partial = true;
export function getStaticPaths() {
  return [...staffByCommittee].filter(([, rows]) => rows.length > STAFF_SHOWN).map(([id, rows]) => ({ params: { id }, props: { rows } }));
}
const { rows } = Astro.props as { rows: StaffRow[] };
---

<StaffTable rows={rows.slice(STAFF_SHOWN)} />
