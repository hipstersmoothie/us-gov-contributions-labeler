---
import Base from "../../layouts/Base.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import { sectors } from "../../lib/sectors";
import { cycleRange, money } from "../../lib/data";

const total = sectors.reduce((s, x) => s + x.total, 0);
const biggest = sectors.find((s) => !["Unknown", "Party & Candidate Committees"].includes(s.name))!;
---

<Base
  title="PAC money to Congress by industry sector"
  og={{ type: "page", id: "sectors" }}
  description={`${money(total, true)} in PAC money to current members of Congress from ${cycleRange.replace("–", " to ")}, by the sector of the organization behind each PAC. ${biggest.name} gave the most, ${money(biggest.total, true)}.`}
  crumbs={[["Sectors", "/sectors/"]]}
>
  <h1>Sectors</h1>
  <p class="dek">PAC contributions to current members by the sector of the organization behind each PAC, {cycleRange}.</p>
  <section class="story">
    <h2>PAC money by sector</h2>
    <p class="chart-dek">Each sector's total, with the number of organizations behind it.</p>
    <PlotFigure
      chart="bars"
      label="PAC money by sector"
      data={{
        rows: sectors.map((s) => ({
          label: s.name,
          value: s.total,
          href: `/sectors/${s.slug}/`,
          note: `${s.organizations.length.toLocaleString()} organizations`,
        })),
        emphasize: [0],
        total,
      }}
      table={{ columns: ["Sector", "Organizations", "PAC money"], numeric: [1, 2], rows: sectors.map((s) => [s.name, s.organizations.length, money(s.total)]) }}
    />
  </section>
</Base>
