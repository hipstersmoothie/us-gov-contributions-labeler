---
import Base from "../../layouts/Base.astro";
import BarList from "../../components/BarList.astro";
import { sectors } from "../../lib/sectors";
import { cycleRange } from "../../lib/data";

const total = sectors.reduce((s, x) => s + x.total, 0);
---

<Base title="Sectors" description="PAC money to Congress by industry sector.">
  <h1>Sectors</h1>
  <p class="eyebrow">PAC contributions to current members by sector, {cycleRange}.</p>
  <section class="card">
    <BarList
      total={total}
      rows={sectors.map((s) => ({
        label: s.name,
        value: s.total,
        href: `/sectors/${s.slug}/`,
        note: `${s.organizations.length.toLocaleString()} organizations`,
      }))}
    />
  </section>
</Base>
