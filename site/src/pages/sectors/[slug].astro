---
import Base from "../../layouts/Base.astro";
import BarList from "../../components/BarList.astro";
import SplitBar from "../../components/SplitBar.astro";
import { sectors, type SectorSummary } from "../../lib/sectors";
import { memberById, money, cycleRange } from "../../lib/data";

export function getStaticPaths() {
  return sectors.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: SectorSummary };
---

<Base title={s.name} description={`PAC money from ${s.name} to Congress, ${cycleRange}.`}>
  <h1>{s.name}</h1>
  <p class="eyebrow">PAC contributions to current members, {cycleRange}.</p>

  <dl class="stats">
    <div class="stat"><dt>Given</dt><dd>{money(s.total, true)}</dd></div>
    <div class="stat"><dt>Organizations</dt><dd>{s.organizations.length.toLocaleString()}</dd></div>
    <div class="stat"><dt>Members funded</dt><dd>{s.recipients.length}</dd></div>
  </dl>

  <section class="card">
    <h2>Split by party</h2>
    <SplitBar
      label="Sector contributions by recipient party"
      segments={[
        { label: "Democrats", value: s.split.Democrat, color: "--party-d" },
        { label: "Independents", value: s.split.Independent, color: "--party-i" },
        { label: "Republicans", value: s.split.Republican, color: "--party-r" },
      ]}
    />
  </section>

  <div class="grid-2">
    <section class="card">
      <h2>Biggest givers</h2>
      <BarList
        total={s.total}
        rows={s.organizations.slice(0, 25).map((o) => ({
          label: o.name,
          value: o.total,
          href: `/organizations/${o.id}/`,
          note: o.industry,
        }))}
      />
      <p class="small"><a href={`/organizations/?sector=${encodeURIComponent(s.name)}`}>All {s.name} organizations</a></p>
    </section>

    <section class="card">
      <h2>Top recipients</h2>
      <BarList
        total={s.total}
        rows={s.recipients.slice(0, 25).map((r) => {
          const m = memberById.get(r.id);
          return { label: m?.name ?? r.id, value: r.total, href: `/members/${r.id}/`, note: m ? `${m.party} · ${m.state}` : undefined };
        })}
      />
    </section>
  </div>
</Base>
