{
  "name": "us-gov-contributions-labeler",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "start": "tsx src/label-server.ts",
    "discover": "tsx src/ingest.ts --steps=accounts",
    "read-dms": "tsx src/read-dms.ts",
    "typecheck": "tsc --noEmit",
    "ingest": "NODE_OPTIONS=--max-old-space-size=12288 tsx src/ingest.ts",
    "fec-audit": "tsx src/scripts/fec-cache-audit.ts",
    "race-results": "tsx src/scripts/race-results.ts",
    "test:races": "tsx src/scripts/race-results-test.ts",
    "site:dev": "pnpm --filter site dev",
    "site:build": "pnpm --filter site build",
    "sync-labels": "tsx src/sync-labels.ts",
    "publish-records": "tsx src/publish-records.ts",
    "build-sqlite": "tsx src/build-sqlite.ts",
    "sync-lists": "tsx src/sync-lists.ts",
    "dedupe-labels": "tsx src/scripts/dedupe-labels.ts",
    "photos": "tsx src/scripts/fetch-photos.ts",
    "zip-districts": "tsx src/scripts/zip-districts.ts",
    "feeds": "tsx feeds/server.ts",
    "feeds:publish": "tsx feeds/publish.ts",
    "open-data-examples": "tsx src/scripts/open-data-examples.ts",
    "bluesky-profiles": "tsx src/scripts/fetch-bluesky-profiles.ts",
    "review-scans": "tsx src/scripts/disclosures/scan/review-server.ts",
    "holdings:publish": "tsx src/scripts/disclosures/house-build.ts && tsx src/scripts/disclosures/seal.ts && git commit -m 'Holdings: apply scan review decisions' -- data/holdings.json.enc && git push origin HEAD:main",
    "holdings": "tsx src/scripts/disclosures/house-all.ts && tsx src/scripts/disclosures/scan/run-ptrs.ts && tsx src/scripts/disclosures/scan/run-annuals.ts && tsx src/scripts/disclosures/scan/statements.ts && tsx src/scripts/disclosures/house-build.ts && tsx src/scripts/disclosures/seal.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@types/node": "^24.19.2",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@atproto/api": "^0.13.16",
    "@atproto/identity": "^0.4.3",
    "@atproto/lexicon": "^0.7.19",
    "@skyware/labeler": "^0.1.8",
    "await-to-js": "^3.0.0",
    "axios": "^1.7.7",
    "dedent": "^1.5.3",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.12.1",
    "libsql": "0.5.0-pre.2",
    "tsx": "^4.19.2"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee",
  "pnpm": {
    "patchedDependencies": {
      "@skyware/labeler@0.1.13": "patches/@skyware__labeler@0.1.13.patch"
    }
  }
}
